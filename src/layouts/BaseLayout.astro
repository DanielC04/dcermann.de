---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.scss';
import { getImage } from 'astro:assets';
import { url } from '../utils/url';
import profilePhoto from '../assets/images/myProfile.png';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph type: 'website' for pages, 'article' for reading notes. */
  ogType?: 'website' | 'article';
  /** Load the Devicon stylesheet (only the projects section uses it). */
  devicons?: boolean;
}

const {
  title = 'Daniel Cermann',
  description = 'Software engineer focused on AI safety, studying IT-Systems Engineering at HPI.',
  ogType = 'website',
  devicons = false,
} = Astro.props;

const fullTitle = title === 'Daniel Cermann' ? title : `${title} — Daniel Cermann`;

// Link previews (LinkedIn, Slack, WhatsApp, …) need absolute URLs.
// Trailing slash: GitHub Pages redirects /dcermann.de → /dcermann.de/.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL((await getImage({ src: profilePhoto, width: 400, height: 400, format: 'jpg' })).src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Daniel Cermann" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <meta property="og:image:alt" content="Daniel Cermann" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={url('/dc-logo.svg')} />
    <link rel="manifest" href={url('/manifest.json')} />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@200;300&family=Space+Grotesk:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    {devicons && (
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css"
      />
    )}
    <!-- Prevent theme flash: read localStorage before first paint -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        document.documentElement.setAttribute('data-theme', saved || 'dark');
      })();
    </script>
  </head>
  <body>
    <!-- Apply theme to body as soon as it exists -->
    <script is:inline>
      document.body.setAttribute(
        'data-theme',
        localStorage.getItem('theme') || 'dark',
      );
    </script>

    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Scroll-reveal observer (runs on every page) -->
    <script>
      const revealEls = document.querySelectorAll(
        '.reveal, .reveal-left, .reveal-right',
      );
      if (revealEls.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                observer.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        revealEls.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
