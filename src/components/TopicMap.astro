---
/**
 * TopicMap — "What I read about".
 *
 * Two linked views of the reading list:
 *
 *   1. A topic network. Circles are topics (src/data/topics.ts), their area
 *      proportional to the topic's share of all interest. How papers appear
 *      depends on how many there are:
 *
 *        - detail view (≤ DETAIL_LIMIT papers): every paper is a dot, linked to
 *          each topic its tags map to. A force layout pulls each paper toward
 *          its topics, so papers covering several topics settle between them.
 *        - overview (more papers): only topics are drawn, joined by lines whose
 *          width is the number of papers they share. Selecting a topic lays out
 *          just that topic's papers as dots (client-side), so density stays
 *          bounded however long the list gets.
 *
 *      The map lives in a fixed frame (FRAME in utils/topicLayout.ts), so labels
 *      and dots keep their on-screen size as the list grows.
 *   2. Interest bars. The same score per topic as a ranked, stacked bar, split
 *      by reading status, for exact comparison.
 *
 * The layout is computed here at build time (d3-force is deterministic, and
 * initial positions are seeded from slugs/ids, not array order), so the map
 * renders without JS. The client script reads positions back from the SVG and
 * adds hover highlighting, dragging (the same simulation, run live), and
 * two-way linking with ReadingList: clicking a topic filters the list, and list
 * filters dim the map.
 *
 * Events (on document):
 *   dispatched  topicmap:select     { topic: string }   — toggle topic filter
 *   listened    readinglist:change  { topic: string | null, visible: string[] | null }
 *   listened    readinglist:hover   { slug: string | null }
 *   dispatched  topicmap:ready      — once listening, so the list can resend its state
 */
import { getCollection } from 'astro:content';
import { topics, statusWeight, topicIdsForTags } from '../data/topics';
import {
  createSimulation,
  clampToFrame,
  hash01,
  seedOffset,
  FRAME,
  VIEWBOX,
  PAPER_R,
  LABEL_FONT,
  type LayoutNode,
  type LayoutLinks,
} from '../utils/topicLayout';
import { url } from '../utils/url';

type Status = keyof typeof statusWeight;

const STATUS_LABEL: Record<Status, string> = {
  'read':    'read',
  'reading': 'reading now',
  'to-read': 'to read',
};

/** Above this many papers the map shows topics only until one is selected. */
const DETAIL_LIMIT = 75;

// ── Papers → topics ──────────────────────────────────────────────────────────

const allPapers = await getCollection('papers', ({ data }) => !data.draft);

const papers = allPapers
  .map((p) => {
    const hasNotes = (p.body ?? '').trim().length > 0;
    return {
      slug:     p.slug,
      title:    p.data.title,
      year:     p.data.year,
      type:     p.data.type,
      status:   p.data.status as Status,
      href:     hasNotes ? url(`/papers/${p.slug}`) : p.data.url,
      external: !hasNotes,
      topicIds: topicIdsForTags(p.data.tags),
    };
  })
  .filter((p) => p.topicIds.length > 0)
  .sort((a, b) => (a.slug < b.slug ? -1 : 1));   // order-independent output

const detail = papers.length <= DETAIL_LIMIT;

// ── Topic stats ──────────────────────────────────────────────────────────────

const topicStats = topics
  .map((t) => {
    const members = papers.filter((p) => p.topicIds.includes(t.id));
    const count = (s: Status) => members.filter((p) => p.status === s).length;
    const counts = { 'read': count('read'), 'reading': count('reading'), 'to-read': count('to-read') };
    const score =
      counts['read'] * statusWeight['read'] +
      counts['reading'] * statusWeight['reading'] +
      counts['to-read'] * statusWeight['to-read'];
    return { id: t.id, label: t.label, group: (t as { group?: string }).group, total: members.length, counts, score };
  })
  .filter((t) => t.total > 0);

const maxScore = Math.max(...topicStats.map((t) => t.score), 1);
const totalScore = topicStats.reduce((s, t) => s + t.score, 0) || 1;

// Circle area ∝ the topic's share of all interest (not of the biggest topic),
// so one dominant topic doesn't flatten everything else to the minimum size.
// About 16% of the frame is shared out between topics, with bounds so tiny
// topics stay hoverable and a dominant one doesn't swallow the map.
const R_MIN = 6;
const R_MAX = 30;
const AREA = FRAME.w * FRAME.h * 0.16;
const radius = (score: number) =>
  Math.max(R_MIN, Math.min(R_MAX, Math.sqrt(((score / totalScore) * AREA) / Math.PI)));

// ── Force layout ─────────────────────────────────────────────────────────────

const tid = (id: string) => `t:${id}`;
const pid = (slug: string) => `p:${slug}`;

// Topics start on a ring at an angle hashed from their id (or their group's id,
// so related topics start together); adding a topic leaves the others in place.
const topicNodes: LayoutNode[] = topicStats.map((t) => {
  const a = t.group
    ? (hash01(`g:${t.group}`) + (hash01(t.id) - 0.5) * 0.15) * Math.PI * 2
    : hash01(t.id) * Math.PI * 2;
  const d = 0.6 + 0.4 * hash01(`${t.id}#r`);
  return { id: tid(t.id), kind: 'topic', r: radius(t.score), label: t.label, x: Math.cos(a) * 100 * d, y: Math.sin(a) * 75 * d };
});
const nodeById: Record<string, LayoutNode> = Object.fromEntries(topicNodes.map((n) => [n.id, n]));

// Papers start at the centroid of their topics, nudged by a hash of their slug.
const paperNodes: LayoutNode[] = detail
  ? papers.map((p) => {
      const ts = p.topicIds.map((id) => nodeById[tid(id)]);
      const o = seedOffset(p.slug, 14);
      return {
        id: pid(p.slug),
        kind: 'paper',
        r: PAPER_R,
        x: ts.reduce((s, t) => s + t.x, 0) / ts.length + o.x,
        y: ts.reduce((s, t) => s + t.y, 0) / ts.length + o.y,
      };
    })
  : [];
paperNodes.forEach((n) => (nodeById[n.id] = n));

const nodes = [...topicNodes, ...paperNodes];

const shared: Record<string, number> = {};
for (const p of papers) {
  for (let i = 0; i < p.topicIds.length; i++)
    for (let j = i + 1; j < p.topicIds.length; j++) {
      const key = `${p.topicIds[i]}|${p.topicIds[j]}`;
      shared[key] = (shared[key] ?? 0) + 1;
    }
}
const topicLinks = Object.entries(shared).map(([key, n]) => {
  const [a, b] = key.split('|');
  return { a, b, n };
});
const maxShared = Math.max(1, ...topicLinks.map((l) => l.n));

const links: LayoutLinks = {
  paper: detail
    ? papers.flatMap((p) => p.topicIds.map((t) => ({ source: pid(p.slug), target: tid(t), bridge: p.topicIds.length > 1 })))
    : [],
  topic: topicLinks.map((l) => ({ source: tid(l.a), target: tid(l.b), n: l.n })),
};

createSimulation(nodes, links).stop().tick(600);

const round = (v: number) => Math.round(v * 10) / 10;
nodes.forEach((n) => { clampToFrame(n); n.x = round(n.x); n.y = round(n.y); });

const pos = (id: string) => nodeById[id];
const svgTopics = topicStats.map((t) => ({ ...t, x: pos(tid(t.id)).x, y: pos(tid(t.id)).y, r: round(pos(tid(t.id)).r) }));
const topicLabel = Object.fromEntries(topicStats.map((t) => [t.id, t.label]));

// Count fits inside the circle (Space Mono ≈ 0.6em per digit at 9.5px)?
const countFits = (t: { r: number; total: number }) => t.r > String(t.total).length * 2.9 + 2;

// ── Paper and edge markup ────────────────────────────────────────────────────
// Rendered as strings: with up to ~1000 papers, Astro's per-element scoping
// attributes alone would add ~30 B per element. Styles for these live in the
// `is:global` block below, scoped by #tm.

const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

// Overview papers carry only what the client needs to draw them on demand
// (it adds the circles and, for external links, target/rel).
const papersHtml = papers
  .map((p) => {
    const n = detail ? pos(pid(p.slug)) : null;
    const attrs = [
      `href="${esc(p.href)}"`,
      detail && p.external ? 'target="_blank" rel="noopener noreferrer"' : '',
      `class="paper s-${p.status}"`,
      `data-slug="${esc(p.slug)}"`,
      `data-topics="${p.topicIds.join(' ')}"`,
      `data-meta="${p.type === 'book' ? 'Book' : 'Paper'} · ${p.year} · ${STATUS_LABEL[p.status]}"`,
      'tabindex="-1"',   // the reading list already offers the same links
      n ? `transform="translate(${n.x} ${n.y})"` : '',
    ].filter(Boolean).join(' ');
    if (!detail) return `<a ${attrs}><title>${esc(p.title)}</title></a>`;
    const r = p.status === 'reading' ? PAPER_R - 0.8 : PAPER_R;
    return (
      `<a ${attrs}><title>${esc(p.title)} (${STATUS_LABEL[p.status]})</title>` +
      `<circle class="hit" r="9"/>` +
      (p.status === 'reading' ? `<circle class="pulse" r="${PAPER_R}"/>` : '') +
      `<circle class="dot" r="${r}"/></a>`
    );
  })
  .join('');

const edgesHtml = detail
  ? papers
      .flatMap((p) => {
        const a = pos(pid(p.slug));
        return p.topicIds.map((t) => {
          const b = pos(tid(t));
          return `<line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" data-paper="${esc(p.slug)}" data-topic="${t}"/>`;
        });
      })
      .join('')
  : '';

const linkWidth = (n: number) => round(0.8 + 4.2 * Math.sqrt(n / maxShared));

// ── Bars ─────────────────────────────────────────────────────────────────────

const ranked = [...topicStats].sort((a, b) => b.score - a.score || b.total - a.total);
const pct = (v: number) => `${((v / maxScore) * 100).toFixed(2)}%`;

const entries = (n: number) => `${n} ${n === 1 ? 'entry' : 'entries'}`;
const breakdown = (c: Record<Status, number>) =>
  [
    c['read'] && `${c['read']} read`,
    c['reading'] && `${c['reading']} reading`,
    c['to-read'] && `${c['to-read']} to read`,
  ].filter(Boolean).join(' · ');
---

<div class="tm-card" id="tm">
  <header class="tm-head">
    <span class="tm-title">What I read about</span>
    {detail ? (
      <p class="tm-desc">
        Each <strong>circle is a topic</strong>, sized by how much I've read in it.
        Each <strong>dot is a paper or book</strong>, linked to every topic it covers, so
        dots sitting between circles mark where my interests overlap.
      </p>
    ) : (
      <p class="tm-desc">
        Each <strong>circle is a topic</strong>, sized by how much I've read in it.
        <strong>Lines join topics that share entries</strong> — the thicker, the more
        overlap. <span class="js-only" hidden>Select a topic to see its papers and books as dots.</span>
      </p>
    )}
    <ul class:list={['tm-legend', { 'js-only': !detail }]} aria-label="Legend" hidden={!detail}>
      <li><svg width="10" height="10" aria-hidden="true"><circle cx="5" cy="5" r="4" class="leg-read" /></svg>read</li>
      <li><svg width="10" height="10" aria-hidden="true"><circle cx="5" cy="5" r="3.2" class="leg-reading" /></svg>reading now</li>
      <li><svg width="10" height="10" aria-hidden="true"><circle cx="5" cy="5" r="3.6" class="leg-toread" /></svg>to read</li>
    </ul>
    <p class="tm-hint js-only" hidden>
      {detail ? 'Click a topic to filter the list · drag to rearrange' : 'Click a topic to filter the list and show its entries · drag to rearrange'}
    </p>
  </header>

  <!-- Map and interest bars share one panel so the (sticky) card stays short -->
  <div class="tm-tabs js-only" role="tablist" aria-label="View" hidden>
    <button type="button" role="tab" id="tm-tab-map" aria-controls="tm-panel-map" aria-selected="true">Topic map</button>
    <button type="button" role="tab" id="tm-tab-bars" aria-controls="tm-panel-bars" aria-selected="false">Interest by topic</button>
  </div>

  <div class="tm-map" id="tm-panel-map" role="tabpanel" aria-labelledby="tm-tab-map">
    <svg
      viewBox={VIEWBOX}
      role="group"
      aria-labelledby="tm-svg-title"
      class:list={['tm-svg', detail ? 'is-detail' : 'is-overview']}
      data-mode={detail ? 'detail' : 'overview'}
    >
      <title id="tm-svg-title">
        Network of {svgTopics.length} topics and the {papers.length} papers and books that cover them
      </title>

      {!detail && (
        <g class="tlinks">
          {topicLinks.map((l) => (
            <line
              x1={pos(tid(l.a)).x} y1={pos(tid(l.a)).y}
              x2={pos(tid(l.b)).x} y2={pos(tid(l.b)).y}
              stroke-width={linkWidth(l.n)}
              data-a={l.a} data-b={l.b}
            ><title>{topicLabel[l.a]} + {topicLabel[l.b]}: {entries(l.n)} in both</title></line>
          ))}
        </g>
      )}

      <g class="edges" set:html={edgesHtml} />

      <g class="topics">
        {svgTopics.map((t) => (
          <g
            class="topic"
            data-topic={t.id}
            data-tip={`${entries(t.total)} · ${breakdown(t.counts)}`}
            transform={`translate(${t.x} ${t.y})`}
            tabindex="0"
            role="button"
            aria-pressed="false"
            aria-label={`${t.label}: ${entries(t.total)}. Filter the list by this topic.`}
          >
            <title>{t.label}: {entries(t.total)} ({breakdown(t.counts)})</title>
            <circle r={t.r} />
            {countFits(t) && <text class="topic-count" dy="0.35em">{t.total}</text>}
          </g>
        ))}
      </g>

      <g class="papers" set:html={papersHtml} />

      <g class="labels" aria-hidden="true">
        {svgTopics.map((t) => (
          <text
            class="topic-label"
            data-topic={t.id}
            transform={`translate(${t.x} ${t.y})`}
            y={round(t.r + LABEL_FONT + 1.5)}
          >{t.label}</text>
        ))}
      </g>
    </svg>
    <div class="tm-tip" role="tooltip" hidden></div>
  </div>

  <div class="tm-bars" id="tm-panel-bars" role="tabpanel" aria-labelledby="tm-tab-bars">
    <h3 id="tm-bars-title" class="tm-subtitle">Interest by topic</h3>
    <ol>
      {ranked.map((t) => (
        <li>
          <button class="bar-row" type="button" data-topic={t.id} aria-pressed="false" disabled>
            <span class="bar-label">{t.label}</span>
            <span class="bar-track" aria-hidden="true">
              {t.counts['read'] > 0 && (
                <span class="seg s-read" style={`width:${pct(t.counts['read'] * statusWeight['read'])}`}></span>
              )}
              {t.counts['reading'] > 0 && (
                <span class="seg s-reading" style={`width:${pct(t.counts['reading'] * statusWeight['reading'])}`}></span>
              )}
              {t.counts['to-read'] > 0 && (
                <span class="seg s-to-read" style={`width:${pct(t.counts['to-read'] * statusWeight['to-read'])}`}></span>
              )}
            </span>
            <span class="bar-counts">{breakdown(t.counts)}</span>
          </button>
        </li>
      ))}
    </ol>
    <p class="tm-note">
      Interest = entries in the topic, where a finished one counts {statusWeight['read']},
      one in progress {statusWeight['reading']}, and one on the to-read list {statusWeight['to-read']}.
      An entry counts toward every topic it covers.
    </p>
  </div>
</div>

<style lang="scss">
  .tm-card {
    // Local roles so the marks read from one place in both themes.
    --tm-accent:   var(--contrast-color);
    --tm-ink:      var(--text-color);
    --tm-ink-dim:  var(--text-color-dim);
    --tm-surface:  var(--background-color-1);
    --tm-topic-fill: color-mix(in srgb, var(--tm-accent) 16%, var(--tm-surface));

    border: 1px solid color-mix(in srgb, var(--tm-ink-dim) 20%, transparent);
    border-radius: 10px;
    background: var(--tm-surface);
    padding: 1rem 1.1rem 1.1rem;

    // Float beside the list while scrolling, but only where the whole card
    // fits on screen — never clipped, never inner-scrolled. The map has a
    // fixed aspect ratio (see FRAME), so the card's height no longer depends
    // on the data.
    @media (min-width: 769px) and (min-height: 620px) {
      position: sticky;
      top: 76px;   // below the 60px site header
    }
  }

  // ── Tabs ──────────────────────────────────────────────────────────────
  .tm-tabs {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--tm-ink-dim) 15%, transparent);

    &[hidden] { display: none; }

    button {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--tm-ink-dim);
      background: none;
      border: 0;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      padding: 0.3rem 0.6rem;
      cursor: pointer;

      &:hover { color: var(--tm-accent); }

      &[aria-selected='true'] {
        color: var(--tm-ink);
        border-bottom-color: var(--tm-accent);
      }
    }
  }

  .tm-map[hidden],
  .tm-bars[hidden],
  .tm-legend[hidden] { display: none; }

  // ── Header ────────────────────────────────────────────────────────────
  .tm-title,
  .tm-subtitle {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--tm-accent);
    margin: 0;
  }

  .tm-desc {
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--tm-ink-dim);
    margin: 0.45rem 0 0.6rem;

    strong { color: var(--tm-ink); font-weight: 600; }
  }

  .tm-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.66rem;
    color: var(--tm-ink-dim);

    li { display: flex; align-items: center; gap: 0.35rem; }
  }

  .tm-hint {
    margin: 0.45rem 0 0;
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.62rem;
    color: var(--tm-accent);
  }

  .leg-read    { fill: var(--tm-ink); }
  .leg-reading { fill: var(--tm-ink); stroke: var(--tm-accent); stroke-width: 1.6; }
  .leg-toread  { fill: var(--tm-surface); stroke: var(--tm-ink-dim); stroke-width: 1.4; }

  // ── Map ───────────────────────────────────────────────────────────────
  .tm-map {
    position: relative;
    margin: 0.75rem 0 0.25rem;
  }

  .tm-svg {
    display: block;
    width: 100%;
    height: auto;
    // Fixed frame → fixed aspect ratio; the cap only matters on very wide
    // single-column layouts.
    max-height: 420px;
    overflow: visible;
    user-select: none;

    &.is-dragging { cursor: grabbing; }
  }

  // ── Tooltip ───────────────────────────────────────────────────────────
  .tm-tip {
    position: absolute;
    z-index: 5;
    max-width: 220px;
    padding: 0.45rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--tm-ink-dim) 25%, transparent);
    border-radius: 6px;
    background: var(--background-color);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.15);
    pointer-events: none;
    line-height: 1.35;

    :global(.tip-title) {
      display: block;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--tm-ink);
    }
    :global(.tip-meta) {
      display: block;
      margin-top: 0.2rem;
      font-family: 'Space Mono', 'Courier New', monospace;
      font-size: 0.64rem;
      color: var(--tm-ink-dim);
    }
  }

  // ── Bars ──────────────────────────────────────────────────────────────
  .tm-bars {
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--tm-ink-dim) 15%, transparent);

    // With tabs, the tab itself is the heading.
    .has-tabs & {
      margin-top: 0.75rem;
      padding-top: 0;
      border-top: 0;

      .tm-subtitle { display: none; }
      ol { margin-top: 0; }
    }

    ol {
      list-style: none;
      margin: 0.6rem 0 0;
      padding: 0;
    }
  }

  .bar-row {
    display: grid;
    width: calc(100% + 0.7rem);
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'label counts'
      'track track';
    gap: 0.2rem 0.5rem;
    padding: 0.3rem 0.35rem;
    margin: 0 -0.35rem;
    border: 0;
    border-radius: 5px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    outline: none;
    transition: background 0.15s;

    &:not(:disabled) { cursor: pointer; }

    &:not(:disabled):hover,
    &:focus-visible,
    &.on {
      background: color-mix(in srgb, var(--tm-accent) 10%, transparent);
    }

    &.selected {
      background: color-mix(in srgb, var(--tm-accent) 20%, transparent);
    }
  }

  .bar-label {
    grid-area: label;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--tm-ink);
  }

  .bar-counts {
    grid-area: counts;
    align-self: center;
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.62rem;
    color: var(--tm-ink-dim);
  }

  .bar-track {
    grid-area: track;
    display: flex;
    gap: 2px;
    height: 6px;
  }

  .seg {
    height: 100%;
    min-width: 3px;
    &:first-child { border-radius: 3px 0 0 3px; }
    &:last-child  { border-radius: 0 3px 3px 0; }
    &:only-child  { border-radius: 3px; }

    &.s-read    { background: var(--tm-accent); }
    &.s-reading { background: color-mix(in srgb, var(--tm-accent) 55%, var(--tm-surface)); }
    &.s-to-read { background: color-mix(in srgb, var(--tm-accent) 25%, var(--tm-surface)); }
  }

  .tm-note {
    margin: 0.7rem 0 0;
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--tm-ink-dim);
  }
</style>

<!--
  SVG internals. Global (scoped by #tm by hand) because paper dots and edges
  are rendered as raw strings without Astro's scoping attributes.
-->
<style lang="scss" is:global>
  #tm .tm-svg {
    .edges line {
      stroke: var(--tm-accent);
      stroke-width: 1;
      opacity: 0.4;
      transition: opacity 0.15s;
    }

    .tlinks line {
      stroke: var(--tm-accent);
      stroke-linecap: round;
      opacity: 0.28;
      transition: opacity 0.15s;
    }

    .topic {
      cursor: pointer;
      outline: none;
      touch-action: none;   // lets a drag start on a node without scrolling the page
      transition: opacity 0.15s;

      circle {
        fill: var(--tm-topic-fill);
        stroke: var(--tm-accent);
        stroke-width: 1.4;
        transition: stroke-width 0.15s, fill 0.15s;
      }

      &:focus-visible circle { stroke-width: 2.6; }

      &.selected circle {
        fill: color-mix(in srgb, var(--tm-accent) 38%, var(--tm-surface));
        stroke-width: 2.4;
      }

      &.out { opacity: 0.35; }
    }

    .topic-count {
      font-family: 'Space Mono', 'Courier New', monospace;
      font-size: 9.5px;
      font-weight: 700;
      fill: var(--tm-ink);
      text-anchor: middle;
      pointer-events: none;
    }

    .topic-label {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 10.5px;
      font-weight: 600;
      fill: var(--tm-ink);
      text-anchor: middle;
      pointer-events: none;
      transition: opacity 0.15s;
      // Halo keeps labels legible where edges pass behind them.
      paint-order: stroke;
      stroke: var(--tm-surface);
      stroke-width: 3px;
      stroke-linejoin: round;
    }

    .paper {
      cursor: pointer;
      outline: none;
      touch-action: none;
      transition: opacity 0.15s;

      .hit { fill: transparent; }

      .dot {
        fill: var(--tm-ink);
        stroke: var(--tm-surface);   // 1px surface ring separates touching dots
        stroke-width: 1;
      }

      &.s-to-read .dot {
        fill: var(--tm-surface);
        stroke: var(--tm-ink-dim);
        stroke-width: 1.4;
      }

      .pulse {
        fill: none;
        stroke: var(--tm-accent);
        stroke-width: 1.6;
        transform-box: fill-box;
        transform-origin: center;
        animation: tm-pulse 2.2s ease-out infinite;
      }

      &.on .dot,
      &:focus-visible .dot { stroke: var(--tm-accent); stroke-width: 2; }
    }

    // Overview: papers exist only for the selected topic.
    &.is-overview .paper:not(.shown) { display: none; }
    &.is-overview .paper .dot { stroke-width: 0.8; }

    // Filtered out by the reading list's filters.
    .paper.out      { opacity: 0.12; }
    .edges line.out { opacity: 0.05; }

    // Focus mode: set while a topic or paper is hovered/focused or a topic is selected.
    &.is-focus {
      .edges line:not(.on)  { opacity: 0.05; }
      .edges line.on        { opacity: 0.9; stroke-width: 1.4; }
      .tlinks line:not(.on) { opacity: 0.06; }
      .tlinks line.on       { opacity: 0.6; }
      .topic:not(.on)       { opacity: 0.3; }
      .topic.on circle      { stroke-width: 2.2; }
      .paper:not(.on)       { opacity: 0.15; }
      .topic-label:not(.on) { opacity: 0.3; }
      .topic.near:not(.on),
      .topic-label.near:not(.on) { opacity: 0.6; }
    }
  }

  @keyframes tm-pulse {
    0%   { transform: scale(1);   opacity: 0.9; }
    100% { transform: scale(2.4); opacity: 0;   }
  }

  @media (prefers-reduced-motion: reduce) {
    #tm .tm-svg .paper .pulse { animation: none; opacity: 1; }
  }
</style>

<script>
  import {
    createSimulation,
    paperRadiusFor,
    seedOffset,
    FRAME,
    PAPER_R,
    type LayoutNode,
    type LayoutLinks,
  } from '../utils/topicLayout';

  const root = document.getElementById('tm');
  const svg = root?.querySelector<SVGSVGElement>('.tm-svg');
  const tip = root?.querySelector<HTMLDivElement>('.tm-tip');

  if (root && svg && tip) {
    const detail = svg.dataset.mode === 'detail';
    const barEls = [...root.querySelectorAll<HTMLButtonElement>('.bar-row')];

    root.querySelectorAll<HTMLElement>('.js-only').forEach((el) => (el.hidden = false));
    barEls.forEach((el) => (el.disabled = false));

    // ── Tabs: map / ranking ────────────────────────────────────────────────
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    function showTab(tab: HTMLButtonElement) {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
    }
    root.classList.add('has-tabs');
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => showTab(t));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        showTab(next);
        next.focus();
      });
    });
    showTab(tabs[0]);

    // ── Index the SVG (positions are read back from it — no JSON copy) ─────
    const parsePos = (el: Element) => {
      const m = /translate\(([-\d.]+)[ ,]+([-\d.]+)\)/.exec(el.getAttribute('transform') ?? '');
      return m ? { x: +m[1], y: +m[2] } : { x: 0, y: 0 };
    };

    type Topic = {
      id: string;
      el: SVGGElement;
      label: SVGTextElement | undefined;
      bar: HTMLButtonElement | undefined;
      node: LayoutNode;
      papers: Paper[];
      edges: SVGLineElement[];
      links: { el: SVGLineElement; other: string }[];
    };
    type Paper = {
      slug: string;
      el: SVGAElement;
      topics: string[];
      node: LayoutNode;
      edges: { el: SVGLineElement; topic: string }[];
    };

    const labelByTopic = new Map(
      [...svg.querySelectorAll<SVGTextElement>('.topic-label')].map((el) => [el.dataset.topic!, el]));
    const barByTopic = new Map(barEls.map((el) => [el.dataset.topic!, el]));

    const topicById = new Map<string, Topic>();
    for (const el of svg.querySelectorAll<SVGGElement>('.topic')) {
      const id = el.dataset.topic!;
      const label = labelByTopic.get(id);
      topicById.set(id, {
        id, el, label,
        bar: barByTopic.get(id),
        node: {
          id: `t:${id}`, kind: 'topic',
          r: +(el.querySelector('circle')?.getAttribute('r') ?? 10),
          label: label?.textContent ?? '',
          ...parsePos(el),
        },
        papers: [], edges: [], links: [],
      });
    }

    const paperBySlug = new Map<string, Paper>();
    for (const el of svg.querySelectorAll<SVGAElement>('.paper')) {
      const slug = el.dataset.slug!;
      const topics = el.dataset.topics!.split(' ').filter((id) => topicById.has(id));
      const p: Paper = { slug, el, topics, node: { id: `p:${slug}`, kind: 'paper', r: PAPER_R, ...parsePos(el) }, edges: [] };
      paperBySlug.set(slug, p);
      topics.forEach((id) => topicById.get(id)!.papers.push(p));
    }

    for (const el of svg.querySelectorAll<SVGLineElement>('.edges line')) {
      const p = paperBySlug.get(el.dataset.paper!);
      const t = topicById.get(el.dataset.topic!);
      if (!p || !t) continue;
      p.edges.push({ el, topic: t.id });
      t.edges.push(el);
    }
    for (const el of svg.querySelectorAll<SVGLineElement>('.tlinks line')) {
      const a = topicById.get(el.dataset.a!), b = topicById.get(el.dataset.b!);
      if (!a || !b) continue;
      a.links.push({ el, other: b.id });
      b.links.push({ el, other: a.id });
    }

    const topicList = [...topicById.values()];
    const nodeOwner = new Map<string, Topic | Paper>([
      ...topicList.map((t): [string, Topic] => [t.node.id, t]),
      ...[...paperBySlug.values()].map((p): [string, Paper] => [p.node.id, p]),
    ]);

    // Topic ↔ topic overlap counts, rebuilt from the papers' topic lists.
    const topicLinks: LayoutLinks['topic'] = (() => {
      const shared = new Map<string, number>();
      for (const p of paperBySlug.values())
        for (let i = 0; i < p.topics.length; i++)
          for (let j = i + 1; j < p.topics.length; j++) {
            const k = `${p.topics[i]}|${p.topics[j]}`;
            shared.set(k, (shared.get(k) ?? 0) + 1);
          }
      return [...shared].map(([k, n]) => {
        const [a, b] = k.split('|');
        return { source: `t:${a}`, target: `t:${b}`, n };
      });
    })();

    // ── Highlight state ────────────────────────────────────────────────────
    type Focus = { kind: 'topic'; id: string } | { kind: 'paper'; slug: string } | null;

    let hover: Focus = null;
    let selected: string | null = null;       // topic filter, mirrored from the list
    let visible: Set<string> | null = null;   // slugs matching the list's filters
    let shown = new Set<Paper>();             // papers with a dot on the map

    // Only elements whose state changes are touched: the previous `on` set is
    // diffed against the next one.
    let onEls = new Set<Element>();
    let nearEls = new Set<Element>();
    const swap = (prev: Set<Element>, next: Set<Element>, cls: string) => {
      for (const el of prev) if (!next.has(el)) el.classList.remove(cls);
      for (const el of next) if (!prev.has(el)) el.classList.add(cls);
      return next;
    };
    function paint() {
      const focus: Focus = hover ?? (selected ? { kind: 'topic', id: selected } : null);
      const next = new Set<Element>();
      const near = new Set<Element>();
      const addTopic = (t: Topic | undefined, set = next) => {
        if (!t) return;
        set.add(t.el);
        if (t.label) set.add(t.label);
      };

      if (focus?.kind === 'topic') {
        const t = topicById.get(focus.id);
        if (t) {
          addTopic(t);
          if (t.bar) next.add(t.bar);
          t.edges.forEach((el) => next.add(el));
          t.papers.forEach((p) => shown.has(p) && next.add(p.el));
          // Overview: its overlap lines, and (half-lit) the topics they lead to.
          t.links.forEach(({ el, other }) => { next.add(el); addTopic(topicById.get(other), near); });
        }
      } else if (focus?.kind === 'paper') {
        const p = paperBySlug.get(focus.slug);
        if (p) {
          if (shown.has(p)) next.add(p.el);
          p.topics.forEach((id) => addTopic(topicById.get(id)));
          p.edges.forEach(({ el }) => next.add(el));
          for (const id of p.topics)
            topicById.get(id)!.links.forEach(({ el, other }) => p.topics.includes(other) && next.add(el));
        }
      }

      onEls = swap(onEls, next, 'on');
      nearEls = swap(nearEls, near, 'near');
      svg!.classList.toggle('is-focus', focus !== null);

      if (focus?.kind === 'paper') {
        const p = paperBySlug.get(focus.slug);
        if (p && shown.has(p)) showPaperTip(p);
        else tip!.hidden = true;
      } else if (hover?.kind === 'topic' && topicById.has(hover.id)) {
        showTopicTip(topicById.get(hover.id)!);
      } else {
        tip!.hidden = true;
      }
    }

    let paintedSelected: string | null = null;
    function paintSelected() {
      for (const id of [paintedSelected, selected]) {
        const t = id ? topicById.get(id) : undefined;
        if (!t) continue;
        const on = id === selected;
        for (const el of [t.el, t.bar]) {
          if (!el) continue;
          el.classList.toggle('selected', on);
          el.setAttribute('aria-pressed', String(on));
        }
      }
      paintedSelected = selected;
    }

    // List filters: O(papers), but only when the list's filters change.
    function paintVisible() {
      for (const p of paperBySlug.values()) {
        const out = visible !== null && !visible.has(p.slug);
        p.el.classList.toggle('out', out);
        p.edges.forEach(({ el }) => el.classList.toggle('out', out));
      }
      for (const t of topicList)
        t.el.classList.toggle('out', visible !== null && !t.papers.some((p) => visible!.has(p.slug)));
    }

    function placeTip(box: DOMRect, title: string, ...meta: string[]) {
      const line = (cls: string, text: string) => {
        const span = document.createElement('span');
        span.className = cls;
        span.textContent = text;
        return span;
      };
      tip!.replaceChildren(line('tip-title', title), ...meta.map((m) => line('tip-meta', m)));
      tip!.hidden = false;

      // Place beside the mark, flipped toward the roomier side of the card.
      const map = root!.querySelector('.tm-map')!.getBoundingClientRect();
      const cx = box.left + box.width / 2 - map.left;
      const top = box.top - map.top;
      const w = tip!.offsetWidth;
      const off = box.width / 2 + 6;
      tip!.style.left = `${cx > map.width / 2 ? Math.max(0, cx - w - off) : Math.min(map.width - w, cx + off)}px`;
      tip!.style.top = `${Math.max(0, top - tip!.offsetHeight - 4)}px`;
    }

    const STATUS_SUFFIX = / \((read|reading now|to read)\)$/;
    const titleOf = (p: Paper) => (p.el.querySelector('title')?.textContent ?? '').replace(STATUS_SUFFIX, '');

    // Overview papers ship without circles; add them the first time one is shown.
    const SVG_NS = 'http://www.w3.org/2000/svg';
    function ensureDot(p: Paper) {
      if (p.el.querySelector('.dot')) return;
      const circle = (cls: string) => {
        const c = document.createElementNS(SVG_NS, 'circle');
        c.setAttribute('class', cls);
        p.el.append(c);
      };
      circle('hit');
      if (p.el.classList.contains('s-reading')) circle('pulse');
      circle('dot');
      const href = p.el.getAttribute('href') ?? '';
      if (new URL(href, location.href).origin !== location.origin) {
        p.el.setAttribute('target', '_blank');
        p.el.setAttribute('rel', 'noopener noreferrer');
      }
    }

    function showPaperTip(p: Paper) {
      placeTip(
        p.el.querySelector('.dot')!.getBoundingClientRect(),
        titleOf(p),
        p.el.dataset.meta!,
        p.topics.map((id) => topicById.get(id)!.node.label).join(' + '),
      );
    }

    function showTopicTip(t: Topic) {
      placeTip(t.el.querySelector('circle')!.getBoundingClientRect(), t.node.label!, t.el.dataset.tip!);
    }

    function selectTopic(id: string) {
      document.dispatchEvent(new CustomEvent('topicmap:select', { detail: { topic: id } }));
    }

    // ── Hover / focus / click (delegated: no per-paper listeners) ──────────
    let dragging = false;
    const setHover = (f: Focus) => {
      if (dragging) return;
      const same =
        f === hover ||
        (f?.kind === 'topic' && hover?.kind === 'topic' && f.id === hover.id) ||
        (f?.kind === 'paper' && hover?.kind === 'paper' && f.slug === hover.slug);
      if (same) return;
      hover = f;
      paint();
    };

    const focusOf = (target: EventTarget | null): Focus => {
      const el = (target instanceof Element ? target.closest('.topic, .paper, .bar-row') : null) as
        HTMLElement | SVGElement | null;
      if (!el || !root!.contains(el)) return null;
      if (el.classList.contains('paper')) return { kind: 'paper', slug: el.dataset.slug! };
      return { kind: 'topic', id: el.dataset.topic! };
    };
    root.addEventListener('pointerover', (e) => setHover(focusOf(e.target)));
    root.addEventListener('pointerleave', () => setHover(null));
    root.addEventListener('focusin', (e) => setHover(focusOf(e.target)));
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node)) setHover(null); });

    barEls.forEach((el) => el.addEventListener('click', () => selectTopic(el.dataset.topic!)));
    svg.addEventListener('keydown', (e) => {
      const el = (e.target as Element).closest<SVGGElement>('.topic');
      if (el && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        selectTopic(el.dataset.topic!);
      }
    });

    // ── Live simulation: drag a node and the rest springs along ────────────
    let simNodes: LayoutNode[] = [];
    let sim = createSimulation([], { paper: [], topic: [] }).stop();
    const drawn = new Map<string, string>();   // node id → last transform written

    // Writes only the nodes that moved since the last frame, and their lines.
    function render() {
      const moved = new Set<string>();
      for (const n of simNodes) {
        const tr = `translate(${n.x.toFixed(1)} ${n.y.toFixed(1)})`;
        if (drawn.get(n.id) === tr) continue;
        drawn.set(n.id, tr);
        moved.add(n.id);
        const o = nodeOwner.get(n.id)!;
        o.el.setAttribute('transform', tr);
        if ('label' in o && o.label) o.label.setAttribute('transform', tr);
      }
      const setLine = (el: SVGLineElement, a: LayoutNode, b: LayoutNode) => {
        el.setAttribute('x1', a.x.toFixed(1));
        el.setAttribute('y1', a.y.toFixed(1));
        el.setAttribute('x2', b.x.toFixed(1));
        el.setAttribute('y2', b.y.toFixed(1));
      };
      for (const id of moved) {
        const o = nodeOwner.get(id)!;
        if ('slug' in o) {
          for (const { el, topic } of o.edges) setLine(el, o.node, topicById.get(topic)!.node);
        } else {
          for (const { el, other } of o.links) {
            const b = topicById.get(other)!;
            if (moved.has(b.node.id) && b.id < o.id) continue;   // drawn from the other end
            const [s, t] = el.dataset.a === o.id ? [o, b] : [b, o];
            setLine(el, s.node, t.node);
          }
          for (const el of o.edges) {
            const p = paperBySlug.get(el.dataset.paper!)!;
            if (!moved.has(p.node.id)) setLine(el, p.node, o.node);
          }
        }
      }
    }

    // Rebuilds the simulation over the topics plus the papers currently shown.
    function buildSim(papers: Paper[], paperR: number) {
      sim.stop().on('tick', null);
      simNodes = [...topicList.map((t) => t.node), ...papers.map((p) => p.node)];
      const links: LayoutLinks = {
        paper: papers.flatMap((p) =>
          p.topics.map((t) => ({ source: p.node.id, target: `t:${t}`, bridge: p.topics.length > 1 }))),
        topic: topicLinks,
      };
      sim = createSimulation(simNodes, links, { paperR }).stop().alpha(0);
      sim.on('tick', render);   // d3's timer already runs on requestAnimationFrame
      sim.on('end', unpinTopics);
    }

    // Overview: show the selected topic's papers. They are laid out around the
    // pinned topics by a short synchronous run (bounded work, whatever the
    // count), then settle animated in the live sim; the topics are released
    // when it cools down or a drag starts.
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pinnedTopics: LayoutNode[] = [];
    function unpinTopics() {
      pinnedTopics.forEach((n) => { n.fx = n.fy = null; n.vx = n.vy = 0; });
      pinnedTopics = [];
    }

    function showPapersFor(id: string | null) {
      const papers = id ? topicById.get(id)?.papers ?? [] : [];
      const next = new Set(papers);
      for (const p of shown) if (!next.has(p)) p.el.classList.remove('shown');
      unpinTopics();

      const r = paperRadiusFor(papers.length);
      for (const p of papers) {
        const ts = p.topics.map((t) => topicById.get(t)!.node);
        const o = seedOffset(p.slug, 14 * (r / PAPER_R));
        p.node.x = ts.reduce((s, t) => s + t.x, 0) / ts.length + o.x;
        p.node.y = ts.reduce((s, t) => s + t.y, 0) / ts.length + o.y;
        p.node.vx = p.node.vy = 0;
        p.node.fx = p.node.fy = null;
        ensureDot(p);
        const reading = p.el.classList.contains('s-reading');
        p.el.querySelector('.dot')!.setAttribute('r', String(reading ? r - 0.8 * (r / PAPER_R) : r));
        p.el.querySelector('.pulse')?.setAttribute('r', String(r));
        p.el.querySelector('.hit')!.setAttribute('r', String(Math.max(r + 2, 5)));
      }

      buildSim(papers, r);
      if (papers.length) {
        pinnedTopics = topicList.map((t) => t.node).filter((n) => n.fx == null);
        pinnedTopics.forEach((n) => { n.fx = n.x; n.fy = n.y; });
        // ~15k node-ticks up front (a few frames' worth), the rest animated.
        const ticks = reducedMotion ? 300 : Math.min(300, Math.max(30, Math.round(15000 / papers.length)));
        sim.alpha(1).tick(ticks);
        if (reducedMotion || ticks >= 300) {
          sim.alpha(0);
          unpinTopics();
        } else {
          sim.restart();   // keeps cooling from where the synchronous run stopped
        }
      }
      render();
      for (const p of papers) if (!shown.has(p)) p.el.classList.add('shown');
      shown = next;
    }

    if (detail) {
      shown = new Set(paperBySlug.values());
      buildSim([...shown], PAPER_R);
      simNodes.forEach((n) => drawn.set(n.id, `translate(${n.x.toFixed(1)} ${n.y.toFixed(1)})`));
    } else {
      buildSim([], PAPER_R);
    }

    function toSvg(e: PointerEvent) {
      const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(svg!.getScreenCTM()!.inverse());
      return {
        x: Math.max(-FRAME.w / 2, Math.min(FRAME.w / 2, p.x)),
        y: Math.max(-FRAME.h / 2, Math.min(FRAME.h / 2, p.y)),
      };
    }

    let drag: { node: LayoutNode; x0: number; y0: number; moved: boolean } | null = null;
    let suppressClick = false;

    svg.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      const el = (e.target as Element).closest<SVGElement>('.topic, .paper');
      if (!el) return;
      const owner = el.classList.contains('topic') ? topicById.get(el.dataset.topic!) : paperBySlug.get(el.dataset.slug!);
      if (!owner || !simNodes.includes(owner.node)) return;
      drag = { node: owner.node, x0: e.clientX, y0: e.clientY, moved: false };
    });

    let pending: PointerEvent | null = null;
    window.addEventListener('pointermove', (e) => {
      if (!drag) return;
      if (!drag.moved) {
        if (Math.hypot(e.clientX - drag.x0, e.clientY - drag.y0) < 4) return;
        drag.moved = true;
        unpinTopics();
        hover = null;
        paint();
        dragging = true;
        svg.classList.add('is-dragging');
        sim.alphaTarget(0.3).restart();
      }
      // Coalesce pointer moves to one getScreenCTM per frame.
      if (!pending) requestAnimationFrame(() => {
        if (drag && pending) {
          const p = toSvg(pending);
          drag.node.fx = p.x;
          drag.node.fy = p.y;
        }
        pending = null;
      });
      pending = e;
    });

    const endDrag = () => {
      if (!drag) return;
      if (drag.moved) {
        drag.node.fx = null;
        drag.node.fy = null;
        sim.alphaTarget(0);
        suppressClick = true;
        setTimeout(() => (suppressClick = false), 50);
      }
      drag = null;
      dragging = false;
      svg.classList.remove('is-dragging');
    };
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    // Capture phase: a drag must not also follow a paper link or toggle a topic.
    svg.addEventListener('click', (e) => {
      if (suppressClick) {
        e.preventDefault();
        e.stopPropagation();
        suppressClick = false;
        return;
      }
      const topic = (e.target as Element).closest<SVGGElement>('.topic');
      if (topic) selectTopic(topic.dataset.topic!);
    }, true);

    // ── Link with the reading list ─────────────────────────────────────────
    document.addEventListener('readinglist:change', (e) => {
      const { topic, visible: slugs } = (e as CustomEvent).detail;
      const topicChanged = topic !== selected;
      selected = topic;
      visible = slugs ? new Set(slugs) : null;
      if (!detail && topicChanged) showPapersFor(selected);
      paintSelected();
      paintVisible();
      paint();
    });
    document.addEventListener('readinglist:hover', (e) => {
      const { slug } = (e as CustomEvent).detail;
      setHover(slug ? { kind: 'paper', slug } : null);
    });

    document.dispatchEvent(new CustomEvent('topicmap:ready'));
  }
</script>
