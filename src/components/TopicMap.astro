---
/**
 * TopicMap — "What I read about".
 *
 * Two linked views of the reading list:
 *
 *   1. A topic network. Big circles are topics (src/data/topics.ts), sized by
 *      interest score. Small dots are papers, linked to every topic their tags
 *      map to. A force layout pulls each paper toward its topics, so papers
 *      covering several topics settle between them — that is the overlap.
 *   2. Interest bars. The same score per topic as a ranked, stacked bar, split
 *      by reading status, for exact comparison.
 *
 * The layout is computed here at build time (d3-force is deterministic), so
 * the map renders without JS. The client script adds hover highlighting,
 * dragging (the same simulation, run live), and two-way linking with
 * ReadingList: clicking a topic filters the list, and list filters dim the map.
 *
 * Events (on document):
 *   dispatched  topicmap:select     { topic: string }   — toggle topic filter
 *   listened    readinglist:change  { topic: string | null, visible: string[] | null }
 *   listened    readinglist:hover   { slug: string | null }
 *   dispatched  topicmap:ready      — once listening, so the list can resend its state
 */
import { getCollection } from 'astro:content';
import { topics, tagToTopic, statusWeight, topicIdsForTags } from '../data/topics';
import {
  createSimulation,
  labelBox,
  PAPER_R,
  LABEL_FONT,
  type LayoutNode,
  type LayoutLinks,
} from '../utils/topicLayout';
import { url } from '../utils/url';

type Status = keyof typeof statusWeight;

const STATUS_LABEL: Record<Status, string> = {
  'read':    'read',
  'reading': 'reading now',
  'to-read': 'to read',
};

// ── Papers → topics ──────────────────────────────────────────────────────────

const allPapers = await getCollection('papers', ({ data }) => !data.draft);

const papers = allPapers
  .map((p) => {
    for (const tag of p.data.tags) {
      if (tagToTopic[tag] === undefined) {
        console.warn(`[TopicMap] tag "${tag}" (${p.slug}) has no topic — add it to src/data/topics.ts`);
      }
    }
    const hasNotes = (p.body ?? '').trim().length > 0;
    return {
      slug:     p.slug,
      title:    p.data.title,
      year:     p.data.year,
      type:     p.data.type,
      status:   p.data.status as Status,
      href:     hasNotes ? url(`/papers/${p.slug}`) : p.data.url,
      external: !hasNotes,
      topicIds: topicIdsForTags(p.data.tags),
    };
  })
  .filter((p) => p.topicIds.length > 0);

// ── Topic stats ──────────────────────────────────────────────────────────────

const topicStats = topics
  .map((t) => {
    const members = papers.filter((p) => p.topicIds.includes(t.id));
    const count = (s: Status) => members.filter((p) => p.status === s).length;
    const counts = { 'read': count('read'), 'reading': count('reading'), 'to-read': count('to-read') };
    const score =
      counts['read'] * statusWeight['read'] +
      counts['reading'] * statusWeight['reading'] +
      counts['to-read'] * statusWeight['to-read'];
    return { ...t, total: members.length, counts, score };
  })
  .filter((t) => t.total > 0);

const maxScore = Math.max(...topicStats.map((t) => t.score), 1);

// Circle area ∝ score, with a floor so tiny topics stay hoverable.
const R_MIN = 9;
const R_MAX = 30;
const radius = (score: number) => R_MIN + (R_MAX - R_MIN) * Math.sqrt(score / maxScore);

// ── Force layout ─────────────────────────────────────────────────────────────

const tid = (id: string) => `t:${id}`;
const pid = (slug: string) => `p:${slug}`;

// Topics start evenly on a ring in topics.ts order, so related topics that sit
// next to each other in that list also start next to each other.
const topicNodes: LayoutNode[] = topicStats.map((t, i) => {
  const a = (i / topicStats.length) * Math.PI * 2 - Math.PI / 2;
  return { id: tid(t.id), kind: 'topic', r: radius(t.score), label: t.label, x: Math.cos(a) * 110, y: Math.sin(a) * 80 };
});
const nodeById: Record<string, LayoutNode> = Object.fromEntries(topicNodes.map((n) => [n.id, n]));

// Papers start at the centroid of their topics, nudged apart by index.
const paperNodes: LayoutNode[] = papers.map((p, i) => {
  const ts = p.topicIds.map((id) => nodeById[tid(id)]);
  return {
    id: pid(p.slug),
    kind: 'paper',
    r: PAPER_R,
    x: ts.reduce((s, t) => s + t.x, 0) / ts.length + Math.cos(i * 2.4) * 12,
    y: ts.reduce((s, t) => s + t.y, 0) / ts.length + Math.sin(i * 2.4) * 12,
  };
});
paperNodes.forEach((n) => (nodeById[n.id] = n));

const nodes = [...topicNodes, ...paperNodes];

const shared: Record<string, number> = {};
for (const p of papers) {
  for (let i = 0; i < p.topicIds.length; i++)
    for (let j = i + 1; j < p.topicIds.length; j++) {
      const key = `${tid(p.topicIds[i])}|${tid(p.topicIds[j])}`;
      shared[key] = (shared[key] ?? 0) + 1;
    }
}

const links: LayoutLinks = {
  paper: papers.flatMap((p) =>
    p.topicIds.map((t) => ({ source: pid(p.slug), target: tid(t), bridge: p.topicIds.length > 1 })),
  ),
  topic: Object.entries(shared).map(([key, n]) => {
    const [source, target] = key.split('|');
    return { source, target, n };
  }),
};

createSimulation(nodes, links).stop().tick(600);

const round = (v: number) => Math.round(v * 10) / 10;
nodes.forEach((n) => { n.x = round(n.x); n.y = round(n.y); n.vx = 0; n.vy = 0; });

// Fit the viewBox to the laid-out nodes plus topic labels.
let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
for (const n of nodes) {
  const b = n.kind === 'topic' ? labelBox(n) : null;
  minX = Math.min(minX, n.x - n.r, b?.left ?? Infinity);
  maxX = Math.max(maxX, n.x + n.r, b?.right ?? -Infinity);
  minY = Math.min(minY, n.y - n.r);
  maxY = Math.max(maxY, n.y + n.r, b?.bottom ?? -Infinity);
}
const PAD = 8;
const vb = { x: minX - PAD, y: minY - PAD, w: maxX - minX + PAD * 2, h: maxY - minY + PAD * 2 };
const viewBox = [vb.x, vb.y, vb.w, vb.h].map((v) => v.toFixed(1)).join(' ');

// Shipped to the client for the live (draggable) simulation.
const layout = JSON.stringify({ nodes, links, vb });

const pos = (id: string) => nodeById[id];
const svgTopics = topicStats.map((t) => ({ ...t, x: pos(tid(t.id)).x, y: pos(tid(t.id)).y, r: pos(tid(t.id)).r }));
const svgPapers = papers.map((p) => ({ ...p, node: pos(pid(p.slug)) }));

// ── Bars ─────────────────────────────────────────────────────────────────────

const ranked = [...topicStats].sort((a, b) => b.score - a.score || b.total - a.total);
const pct = (v: number) => `${((v / maxScore) * 100).toFixed(2)}%`;

const topicLabel = Object.fromEntries(topicStats.map((t) => [t.id, t.label]));
const entries = (n: number) => `${n} ${n === 1 ? 'entry' : 'entries'}`;
---

<div class="tm-card" id="tm">
  <header class="tm-head">
    <span class="tm-title">What I read about</span>
    <p class="tm-desc">
      Each <strong>circle is a topic</strong>, sized by how much I've read in it.
      Each <strong>dot is a paper or book</strong>, linked to every topic it covers, so
      dots sitting between circles mark where my interests overlap.
    </p>
    <ul class="tm-legend" aria-label="Legend">
      <li><svg width="10" height="10" aria-hidden="true"><circle cx="5" cy="5" r="4" class="leg-read" /></svg>read</li>
      <li><svg width="10" height="10" aria-hidden="true"><circle cx="5" cy="5" r="3.2" class="leg-reading" /></svg>reading now</li>
      <li><svg width="10" height="10" aria-hidden="true"><circle cx="5" cy="5" r="3.6" class="leg-toread" /></svg>to read</li>
    </ul>
    <p class="tm-hint js-only" hidden>Click a topic to filter the list · drag to rearrange</p>
  </header>

  <!-- Map and interest bars share one panel so the (sticky) card stays short -->
  <div class="tm-tabs js-only" role="tablist" aria-label="View" hidden>
    <button type="button" role="tab" id="tm-tab-map" aria-controls="tm-panel-map" aria-selected="true">Topic map</button>
    <button type="button" role="tab" id="tm-tab-bars" aria-controls="tm-panel-bars" aria-selected="false">Interest by topic</button>
  </div>

  <div class="tm-map" id="tm-panel-map" role="tabpanel" aria-labelledby="tm-tab-map">
    <svg
      viewBox={viewBox}
      role="group"
      aria-labelledby="tm-svg-title"
      class="tm-svg"
      data-layout={layout}
    >
      <title id="tm-svg-title">
        Network of {svgTopics.length} topics and the {svgPapers.length} papers and books that cover them
      </title>

      <g class="edges">
        {svgPapers.flatMap((p) =>
          p.topicIds.map((t) => (
            <line
              x1={p.node.x} y1={p.node.y}
              x2={pos(tid(t)).x} y2={pos(tid(t)).y}
              data-paper={p.slug} data-topic={t}
            />
          )),
        )}
      </g>

      <g class="topics">
        {svgTopics.map((t) => (
          <g
            class="topic"
            data-topic={t.id}
            data-node={tid(t.id)}
            transform={`translate(${t.x} ${t.y})`}
            tabindex="0"
            role="button"
            aria-pressed="false"
            aria-label={`${t.label}: ${entries(t.total)}. Filter the list by this topic.`}
          >
            <circle r={t.r} />
            <text class="topic-count" dy="0.35em">{t.total}</text>
          </g>
        ))}
      </g>

      <g class="papers">
        {svgPapers.map((p) => (
          <a
            href={p.href}
            target={p.external ? '_blank' : undefined}
            rel={p.external ? 'noopener noreferrer' : undefined}
            class={`paper s-${p.status}`}
            data-slug={p.slug}
            data-node={pid(p.slug)}
            data-topics={p.topicIds.join(' ')}
            data-title={p.title}
            data-meta={`${p.type === 'book' ? 'Book' : 'Paper'} · ${p.year} · ${STATUS_LABEL[p.status]}`}
            data-in={p.topicIds.map((t) => topicLabel[t]).join(' + ')}
            transform={`translate(${p.node.x} ${p.node.y})`}
          >
            <title>{p.title} ({STATUS_LABEL[p.status]})</title>
            {/* Invisible, larger hit target than the dot itself */}
            <circle class="hit" r="9" />
            {p.status === 'reading' && <circle class="pulse" r={PAPER_R} />}
            <circle class="dot" r={p.status === 'reading' ? PAPER_R - 0.8 : PAPER_R} />
          </a>
        ))}
      </g>

      <g class="labels" aria-hidden="true">
        {svgTopics.map((t) => (
          <text
            class="topic-label"
            data-topic={t.id}
            data-node={tid(t.id)}
            transform={`translate(${t.x} ${t.y})`}
            y={t.r + LABEL_FONT + 2}
          >{t.label}</text>
        ))}
      </g>
    </svg>
    <div class="tm-tip" role="tooltip" hidden></div>
  </div>

  <div class="tm-bars" id="tm-panel-bars" role="tabpanel" aria-labelledby="tm-tab-bars">
    <h3 id="tm-bars-title" class="tm-subtitle">Interest by topic</h3>
    <ol>
      {ranked.map((t) => (
        <li>
          <button class="bar-row" type="button" data-topic={t.id} aria-pressed="false" disabled>
            <span class="bar-label">{t.label}</span>
            <span class="bar-track" aria-hidden="true">
              {t.counts['read'] > 0 && (
                <span class="seg s-read" style={`width:${pct(t.counts['read'] * statusWeight['read'])}`}></span>
              )}
              {t.counts['reading'] > 0 && (
                <span class="seg s-reading" style={`width:${pct(t.counts['reading'] * statusWeight['reading'])}`}></span>
              )}
              {t.counts['to-read'] > 0 && (
                <span class="seg s-to-read" style={`width:${pct(t.counts['to-read'] * statusWeight['to-read'])}`}></span>
              )}
            </span>
            <span class="bar-counts">
              {[
                t.counts['read'] && `${t.counts['read']} read`,
                t.counts['reading'] && `${t.counts['reading']} reading`,
                t.counts['to-read'] && `${t.counts['to-read']} to read`,
              ].filter(Boolean).join(' · ')}
            </span>
          </button>
        </li>
      ))}
    </ol>
    <p class="tm-note">
      Interest = entries in the topic, where a finished one counts {statusWeight['read']},
      one in progress {statusWeight['reading']}, and one on the to-read list {statusWeight['to-read']}.
      An entry counts toward every topic it covers.
    </p>
  </div>
</div>

<style lang="scss">
  .tm-card {
    // Local roles so the marks read from one place in both themes.
    --tm-accent:   var(--contrast-color);
    --tm-ink:      var(--text-color);
    --tm-ink-dim:  var(--text-color-dim);
    --tm-surface:  var(--background-color-1);
    --tm-topic-fill: color-mix(in srgb, var(--tm-accent) 16%, var(--tm-surface));

    border: 1px solid color-mix(in srgb, var(--tm-ink-dim) 20%, transparent);
    border-radius: 10px;
    background: var(--tm-surface);
    padding: 1rem 1.1rem 1.1rem;

    // Float beside the list while scrolling, but only where the whole card
    // fits on screen (it's ~520px tall) — never clipped, never inner-scrolled.
    @media (min-width: 769px) and (min-height: 620px) {
      position: sticky;
      top: 76px;   // below the 60px site header
    }
  }

  // ── Tabs ──────────────────────────────────────────────────────────────
  .tm-tabs {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--tm-ink-dim) 15%, transparent);

    &[hidden] { display: none; }

    button {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--tm-ink-dim);
      background: none;
      border: 0;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      padding: 0.3rem 0.6rem;
      cursor: pointer;

      &:hover { color: var(--tm-accent); }

      &[aria-selected='true'] {
        color: var(--tm-ink);
        border-bottom-color: var(--tm-accent);
      }
    }
  }

  .tm-map[hidden],
  .tm-bars[hidden] { display: none; }

  // ── Header ────────────────────────────────────────────────────────────
  .tm-title,
  .tm-subtitle {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--tm-accent);
    margin: 0;
  }

  .tm-desc {
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--tm-ink-dim);
    margin: 0.45rem 0 0.6rem;

    strong { color: var(--tm-ink); font-weight: 600; }
  }

  .tm-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.66rem;
    color: var(--tm-ink-dim);

    li { display: flex; align-items: center; gap: 0.35rem; }
  }

  .tm-hint {
    margin: 0.45rem 0 0;
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.62rem;
    color: var(--tm-accent);
  }

  .leg-read    { fill: var(--tm-ink); }
  .leg-reading { fill: var(--tm-ink); stroke: var(--tm-accent); stroke-width: 1.6; }
  .leg-toread  { fill: var(--tm-surface); stroke: var(--tm-ink-dim); stroke-width: 1.4; }

  // ── Map ───────────────────────────────────────────────────────────────
  .tm-map {
    position: relative;
    margin: 0.75rem 0 0.25rem;
  }

  .tm-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    user-select: none;

    &.is-dragging { cursor: grabbing; }
  }

  .edges line {
    stroke: var(--tm-accent);
    stroke-width: 1;
    opacity: 0.4;
    transition: opacity 0.15s;
  }

  .topic {
    cursor: pointer;
    outline: none;
    touch-action: none;   // lets a drag start on a node without scrolling the page

    circle {
      fill: var(--tm-topic-fill);
      stroke: var(--tm-accent);
      stroke-width: 1.4;
      transition: opacity 0.15s, stroke-width 0.15s, fill 0.15s;
    }

    &:focus-visible circle { stroke-width: 2.6; }

    &.selected circle {
      fill: color-mix(in srgb, var(--tm-accent) 38%, var(--tm-surface));
      stroke-width: 2.4;
    }
  }

  .topic-count {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 10px;
    font-weight: 700;
    fill: var(--tm-ink);
    text-anchor: middle;
    pointer-events: none;
  }

  .topic-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    font-weight: 600;
    fill: var(--tm-ink);
    text-anchor: middle;
    pointer-events: none;
    transition: opacity 0.15s;
    // Halo keeps labels legible where edges pass behind them.
    paint-order: stroke;
    stroke: var(--tm-surface);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .paper {
    cursor: pointer;
    outline: none;
    touch-action: none;
    transition: opacity 0.15s;

    .hit { fill: transparent; }

    .dot {
      fill: var(--tm-ink);
      stroke: var(--tm-surface);   // 1px surface ring separates touching dots
      stroke-width: 1;
    }

    &.s-to-read .dot {
      fill: var(--tm-surface);
      stroke: var(--tm-ink-dim);
      stroke-width: 1.4;
    }

    .pulse {
      fill: none;
      stroke: var(--tm-accent);
      stroke-width: 1.6;
      transform-box: fill-box;
      transform-origin: center;
      animation: tm-pulse 2.2s ease-out infinite;
    }

    &.on .dot,
    &:focus-visible .dot { stroke: var(--tm-accent); stroke-width: 2; }
  }

  @keyframes tm-pulse {
    0%   { transform: scale(1);   opacity: 0.9; }
    100% { transform: scale(2.4); opacity: 0;   }
  }

  @media (prefers-reduced-motion: reduce) {
    .paper .pulse { animation: none; opacity: 1; }
  }

  // Filtered out by the reading list's filters.
  .paper.out      { opacity: 0.12; }
  .edges line.out { opacity: 0.05; }

  // Focus mode: set while a topic or paper is hovered/focused or a topic is selected.
  .tm-svg.is-focus {
    .edges line:not(.on)  { opacity: 0.05; }
    .edges line.on        { opacity: 0.9; stroke-width: 1.4; }
    .topic:not(.on)       { opacity: 0.3; }
    .topic.on circle      { stroke-width: 2.2; }
    .paper:not(.on)       { opacity: 0.15; }
    .topic-label:not(.on) { opacity: 0.3; }
  }

  // ── Tooltip ───────────────────────────────────────────────────────────
  .tm-tip {
    position: absolute;
    z-index: 5;
    max-width: 220px;
    padding: 0.45rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--tm-ink-dim) 25%, transparent);
    border-radius: 6px;
    background: var(--background-color);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.15);
    pointer-events: none;
    line-height: 1.35;

    :global(.tip-title) {
      display: block;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--tm-ink);
    }
    :global(.tip-meta) {
      display: block;
      margin-top: 0.2rem;
      font-family: 'Space Mono', 'Courier New', monospace;
      font-size: 0.64rem;
      color: var(--tm-ink-dim);
    }
  }

  // ── Bars ──────────────────────────────────────────────────────────────
  .tm-bars {
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--tm-ink-dim) 15%, transparent);

    // With tabs, the tab itself is the heading.
    .has-tabs & {
      margin-top: 0.75rem;
      padding-top: 0;
      border-top: 0;

      .tm-subtitle { display: none; }
      ol { margin-top: 0; }
    }

    ol {
      list-style: none;
      margin: 0.6rem 0 0;
      padding: 0;
    }
  }

  .bar-row {
    display: grid;
    width: calc(100% + 0.7rem);
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'label counts'
      'track track';
    gap: 0.2rem 0.5rem;
    padding: 0.3rem 0.35rem;
    margin: 0 -0.35rem;
    border: 0;
    border-radius: 5px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    outline: none;
    transition: background 0.15s;

    &:not(:disabled) { cursor: pointer; }

    &:not(:disabled):hover,
    &:focus-visible,
    &.on {
      background: color-mix(in srgb, var(--tm-accent) 10%, transparent);
    }

    &.selected {
      background: color-mix(in srgb, var(--tm-accent) 20%, transparent);
    }
  }

  .bar-label {
    grid-area: label;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--tm-ink);
  }

  .bar-counts {
    grid-area: counts;
    align-self: center;
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.62rem;
    color: var(--tm-ink-dim);
  }

  .bar-track {
    grid-area: track;
    display: flex;
    gap: 2px;
    height: 6px;
  }

  .seg {
    height: 100%;
    min-width: 3px;
    &:first-child { border-radius: 3px 0 0 3px; }
    &:last-child  { border-radius: 0 3px 3px 0; }
    &:only-child  { border-radius: 3px; }

    &.s-read    { background: var(--tm-accent); }
    &.s-reading { background: color-mix(in srgb, var(--tm-accent) 55%, var(--tm-surface)); }
    &.s-to-read { background: color-mix(in srgb, var(--tm-accent) 25%, var(--tm-surface)); }
  }

  .tm-note {
    margin: 0.7rem 0 0;
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--tm-ink-dim);
  }
</style>

<script>
  import { createSimulation, type LayoutNode, type LayoutLinks } from '../utils/topicLayout';

  const root = document.getElementById('tm');
  const svg = root?.querySelector<SVGSVGElement>('.tm-svg');
  const tip = root?.querySelector<HTMLDivElement>('.tm-tip');

  if (root && svg && tip) {
    const edges = [...svg.querySelectorAll<SVGLineElement>('.edges line')];
    const topicEls = [...svg.querySelectorAll<SVGGElement>('.topic')];
    const labelEls = [...svg.querySelectorAll<SVGTextElement>('.topic-label')];
    const paperEls = [...svg.querySelectorAll<SVGAElement>('.paper')];
    const barEls = [...root.querySelectorAll<HTMLButtonElement>('.bar-row')];

    root.querySelectorAll<HTMLElement>('.js-only').forEach((el) => (el.hidden = false));
    barEls.forEach((el) => (el.disabled = false));

    // ── Tabs: map / ranking ────────────────────────────────────────────────
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    function showTab(tab: HTMLButtonElement) {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
    }
    root.classList.add('has-tabs');
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => showTab(t));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        showTab(next);
        next.focus();
      });
    });
    showTab(tabs[0]);

    // ── Highlight state ────────────────────────────────────────────────────
    type Focus = { kind: 'topic'; id: string } | { kind: 'paper'; slug: string } | null;

    let hover: Focus = null;
    let selected: string | null = null;       // topic filter, mirrored from the list
    let visible: Set<string> | null = null;   // slugs matching the list's filters

    const paperBySlug = new Map(paperEls.map((el) => [el.dataset.slug!, el]));

    function paint() {
      const focus: Focus = hover ?? (selected ? { kind: 'topic', id: selected } : null);
      root!.querySelectorAll('.on').forEach((el) => el.classList.remove('on'));
      svg!.classList.toggle('is-focus', focus !== null);

      if (focus?.kind === 'topic') {
        [...topicEls, ...labelEls, ...edges, ...barEls].forEach((el) =>
          el.classList.toggle('on', (el as HTMLElement).dataset.topic === focus.id));
        paperEls.forEach((el) => el.classList.toggle('on', el.dataset.topics!.split(' ').includes(focus.id)));
      } else if (focus?.kind === 'paper') {
        const el = paperBySlug.get(focus.slug);
        const ids = el?.dataset.topics!.split(' ') ?? [];
        el?.classList.add('on');
        [...topicEls, ...labelEls].forEach((t) => t.classList.toggle('on', ids.includes(t.dataset.topic!)));
        edges.forEach((e) => e.classList.toggle('on', e.dataset.paper === focus.slug));
      }

      paperEls.forEach((el) => el.classList.toggle('out', visible !== null && !visible.has(el.dataset.slug!)));
      edges.forEach((el) => el.classList.toggle('out', visible !== null && !visible.has(el.dataset.paper!)));

      [...topicEls, ...barEls].forEach((el) => {
        const on = (el as HTMLElement).dataset.topic === selected;
        el.classList.toggle('selected', on);
        el.setAttribute('aria-pressed', String(on));
      });

      const tipFor = focus?.kind === 'paper' ? paperBySlug.get(focus.slug) : undefined;
      if (tipFor) showTip(tipFor);
      else tip!.hidden = true;
    }

    function showTip(el: SVGAElement) {
      const line = (cls: string, text: string) => {
        const span = document.createElement('span');
        span.className = cls;
        span.textContent = text;
        return span;
      };
      tip!.replaceChildren(
        line('tip-title', el.dataset.title!),
        line('tip-meta', el.dataset.meta!),
        line('tip-meta', el.dataset.in!),
      );
      tip!.hidden = false;

      // Place beside the dot, flipped toward the roomier side of the card.
      const box = root!.querySelector('.tm-map')!.getBoundingClientRect();
      const dot = el.querySelector('.dot')!.getBoundingClientRect();
      const cx = dot.left + dot.width / 2 - box.left;
      const cy = dot.top + dot.height / 2 - box.top;
      const w = tip!.offsetWidth;
      tip!.style.left = `${cx > box.width / 2 ? Math.max(0, cx - w - 10) : Math.min(box.width - w, cx + 10)}px`;
      tip!.style.top = `${Math.max(0, cy - tip!.offsetHeight - 8)}px`;
    }

    function selectTopic(id: string) {
      document.dispatchEvent(new CustomEvent('topicmap:select', { detail: { topic: id } }));
    }

    // ── Hover / focus / click ──────────────────────────────────────────────
    let dragging = false;
    const setHover = (f: Focus) => {
      if (dragging) return;
      hover = f;
      paint();
    };

    const hoverable: [Element, () => Focus][] = [
      ...[...topicEls, ...barEls].map((el): [Element, () => Focus] =>
        [el, () => ({ kind: 'topic', id: (el as HTMLElement).dataset.topic! })]),
      ...paperEls.map((el): [Element, () => Focus] =>
        [el, () => ({ kind: 'paper', slug: el.dataset.slug! })]),
    ];
    for (const [el, focus] of hoverable) {
      el.addEventListener('mouseenter', () => setHover(focus()));
      el.addEventListener('focus', () => setHover(focus()));
      el.addEventListener('mouseleave', () => setHover(null));
      el.addEventListener('blur', () => setHover(null));
    }

    barEls.forEach((el) => el.addEventListener('click', () => selectTopic(el.dataset.topic!)));
    topicEls.forEach((el) => {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectTopic(el.dataset.topic!);
        }
      });
    });

    // ── Link with the reading list ─────────────────────────────────────────
    document.addEventListener('readinglist:change', (e) => {
      const { topic, visible: slugs } = (e as CustomEvent).detail;
      selected = topic;
      visible = slugs ? new Set(slugs) : null;
      paint();
    });
    document.addEventListener('readinglist:hover', (e) => {
      const { slug } = (e as CustomEvent).detail;
      setHover(slug ? { kind: 'paper', slug } : null);
    });

    // ── Live simulation: drag a node and the rest springs along ────────────
    const { nodes, links, vb } = JSON.parse(svg.dataset.layout!) as {
      nodes: LayoutNode[];
      links: LayoutLinks;
      vb: { x: number; y: number; w: number; h: number };
    };
    const nodeById = new Map(nodes.map((n) => [n.id, n]));
    const elsByNode = new Map<string, Element[]>();
    svg.querySelectorAll<SVGElement>('[data-node]').forEach((el) => {
      const id = el.dataset.node!;
      elsByNode.set(id, [...(elsByNode.get(id) ?? []), el]);
    });
    const edgeEnds = edges.map((el) => ({
      el,
      a: nodeById.get(`p:${el.dataset.paper}`)!,
      b: nodeById.get(`t:${el.dataset.topic}`)!,
    }));

    const sim = createSimulation(nodes, links).stop().alpha(0);

    sim.on('tick', () => {
      // Keep everything inside the original frame so nothing drifts off-card.
      for (const n of nodes) {
        const m = n.r + 1;
        const below = n.kind === 'topic' ? 14 : 0;   // room for the label
        n.x = Math.max(vb.x + m, Math.min(vb.x + vb.w - m, n.x));
        n.y = Math.max(vb.y + m, Math.min(vb.y + vb.h - m - below, n.y));
      }
      for (const [id, els] of elsByNode) {
        const n = nodeById.get(id)!;
        els.forEach((el) => el.setAttribute('transform', `translate(${n.x.toFixed(1)} ${n.y.toFixed(1)})`));
      }
      for (const { el, a, b } of edgeEnds) {
        el.setAttribute('x1', a.x.toFixed(1));
        el.setAttribute('y1', a.y.toFixed(1));
        el.setAttribute('x2', b.x.toFixed(1));
        el.setAttribute('y2', b.y.toFixed(1));
      }
    });

    function toSvg(e: PointerEvent) {
      const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(svg!.getScreenCTM()!.inverse());
      return { x: p.x, y: p.y };
    }

    let drag: { node: LayoutNode; x0: number; y0: number; moved: boolean } | null = null;
    let suppressClick = false;

    svg.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      const el = (e.target as Element).closest<SVGElement>('.topic, .paper');
      if (!el) return;
      drag = { node: nodeById.get(el.dataset.node!)!, x0: e.clientX, y0: e.clientY, moved: false };
    });

    window.addEventListener('pointermove', (e) => {
      if (!drag) return;
      if (!drag.moved) {
        if (Math.hypot(e.clientX - drag.x0, e.clientY - drag.y0) < 4) return;
        drag.moved = true;
        hover = null;
        paint();
        dragging = true;
        svg.classList.add('is-dragging');
        sim.alphaTarget(0.3).restart();
      }
      const p = toSvg(e);
      drag.node.fx = p.x;
      drag.node.fy = p.y;
    });

    const endDrag = () => {
      if (!drag) return;
      if (drag.moved) {
        drag.node.fx = null;
        drag.node.fy = null;
        sim.alphaTarget(0);
        suppressClick = true;
        setTimeout(() => (suppressClick = false), 50);
      }
      drag = null;
      dragging = false;
      svg.classList.remove('is-dragging');
    };
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    // Capture phase: a drag must not also follow a paper link or toggle a topic.
    svg.addEventListener('click', (e) => {
      if (suppressClick) {
        e.preventDefault();
        e.stopPropagation();
        suppressClick = false;
        return;
      }
      const topic = (e.target as Element).closest<SVGGElement>('.topic');
      if (topic) selectTopic(topic.dataset.topic!);
    }, true);

    document.dispatchEvent(new CustomEvent('topicmap:ready'));
  }
</script>
