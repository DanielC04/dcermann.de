    text-decoration: underline;
    text-underline-offset: 2px;
  }

  // ── Sections ──────────────────────────────────────────────────────────
  .list-section {
    margin-bottom: 2.75rem;

    &[hidden] { display: none; }
  }

  .list-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--contrast-color);
    margin: 0 0 0.75rem;
  }

  .list-count {
    font-family: 'Space Mono', 'Courier New', monospace;
