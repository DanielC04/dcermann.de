</style>

<script>
  type SectionId = 'reading' | 'to-read' | 'read';
  interface State {
    q: string;
    status: string;   // '' = all
    type: string;     // '' = all
    topic: string;    // '' = all
    tag: string;      // '' = all
    sort: string;     // '' = recently read
  }

  /** One entry, parsed once from its data-* attributes. */
  interface Item {
    kind: 'item';
    li: HTMLLIElement;
    link: HTMLAnchorElement;
    slug: string;
    status: string;
    type: string;
    topics: Set<string>;
    tags: Set<string>;
    year: number;
    title: string;
    hay: string;      // lowercase search text, filled on first search
    ok: boolean;      // matches every active filter (last apply)
  }
  interface Head {
    kind: 'head';
    li: HTMLLIElement;
    count: HTMLElement;
  }

  // Each section starts with a short page and grows in PAGE steps.
  const FIRST = 10;            // unfiltered
  const FIRST_FILTERED = 20;   // filtered results deserve a longer first look
  const PAGE = 20;
  const KEYS: (keyof State)[] = ['q', 'status', 'type', 'topic', 'tag', 'sort'];

  const root = document.getElementById('rl');

  if (root) {
    const toolbar = root.querySelector<HTMLElement>('.rl-toolbar')!;
    const input = root.querySelector<HTMLInputElement>('#rl-q')!;
    const sortSel = root.querySelector<HTMLSelectElement>('#rl-sort')!;
    const countEl = root.querySelector<HTMLElement>('#rl-count')!;
    const tagChip = root.querySelector<HTMLButtonElement>('#rl-tag')!;
    const clearBtn = root.querySelector<HTMLButtonElement>('#rl-clear')!;
    const emptyEl = root.querySelector<HTMLElement>('#rl-empty')!;
    const facetBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')].map((btn) => ({
      btn,
      key: btn.dataset.filter as 'status' | 'type' | 'topic',
      value: btn.dataset.value!,
      n: btn.querySelector<HTMLElement>('.n'),
    }));

    const items: Item[] = [];
    const itemByLi = new Map<Element, Item>();
    const parse = (li: HTMLLIElement): Item => {
      const d = li.dataset;
      const link = li.querySelector<HTMLAnchorElement>('.paper-title')!;
      const it: Item = {
        kind: 'item',
        li,
        link,
        slug: d.slug!,
        status: d.status!,
        type: d.type!,
        topics: new Set(d.topics ? d.topics.split(' ') : []),
        tags: new Set(d.tags ? d.tags.split(' ') : []),
        year: Number(d.year),
        title: link.textContent!.trim(),
        hay: '',
        ok: true,
      };
      items.push(it);
      itemByLi.set(li, it);
      return it;
    };

    const sections = [...root.querySelectorAll<HTMLElement>('[data-section]')].map((el) => {
      const list = el.querySelector('ol')!;
      // Build order, incl. year heads ("recently read").
      const original: (Item | Head)[] = ([...list.children] as HTMLLIElement[]).map((li) =>
        li.classList.contains('group-head')
          ? { kind: 'head', li, count: li.querySelector<HTMLElement>('.group-count')! }
          : parse(li),
      );
      const row = el.querySelector<HTMLElement>('.show-more-row')!;
      return {
        el,
        id: el.dataset.section as SectionId,
        list,
        countEl: el.querySelector<HTMLElement>('.list-count')!,
        row,
        more: row.querySelector<HTMLButtonElement>('.show-more')!,
        all: row.querySelector<HTMLButtonElement>('.show-all')!,
        original,
        entries: original.filter((x): x is Item => x.kind === 'item'),
        heads: original.filter((x): x is Head => x.kind === 'head'),
        order: original,
        sortedBy: '',
        limit: FIRST,
        shown: [] as Item[],
      };
    });

    toolbar.hidden = false;

    // ── State ↔ URL ────────────────────────────────────────────────────────
    const params = new URLSearchParams(location.search);
    const state: State = Object.fromEntries(KEYS.map((k) => [k, params.get(k) ?? ''])) as State;
    input.value = state.q;
    sortSel.value = state.sort;
    if (sortSel.value !== state.sort) state.sort = '';   // unknown ?sort= value

    function writeUrl() {
      const p = new URLSearchParams();
      KEYS.forEach((k) => state[k] && p.set(k, state[k]));
      const qs = p.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    const isFiltered = () => !!(state.q || state.status || state.type || state.topic || state.tag);

    // Search text = everything the entry shows (title, byline, year, summary,
    // tags) plus the full author list from the byline's tooltip. Built once,
    // on the first search.
    let hayReady = false;
    function ensureHay() {
      if (hayReady) return;
      for (const it of items) {
        const authors = it.li.querySelector<HTMLElement>('.paper-authors')?.title ?? '';
        it.hay = `${it.li.textContent} ${authors}`.toLowerCase().replace(/\s+/g, ' ');
      }
      hayReady = true;
    }

    const collator = new Intl.Collator('en', { sensitivity: 'base', numeric: true });
    const sorters: Record<string, (a: Item, b: Item) => number> = {
      year: (a, b) => b.year - a.year || collator.compare(a.title, b.title),
      title: (a, b) => collator.compare(a.title, b.title) || b.year - a.year,
    };

    // ── Tag buttons (roving tabindex, pressed state) ─────────────────────────
    let tagIndex: Map<string, HTMLButtonElement[]> | null = null;
    function tagButtons(tag: string) {
      if (!tagIndex) {
        tagIndex = new Map();
        root!.querySelectorAll<HTMLButtonElement>('.paper-item .tag').forEach((b) => {
          const t = b.textContent!.trim();
          const list = tagIndex!.get(t);
          if (list) list.push(b);
          else tagIndex!.set(t, [b]);
        });
      }
      return tagIndex.get(tag) ?? [];
    }
    let pressedTag = '';
    function syncTagButtons() {
      if (pressedTag === state.tag) return;
      if (pressedTag) tagButtons(pressedTag).forEach((b) => b.removeAttribute('aria-pressed'));
      if (state.tag) tagButtons(state.tag).forEach((b) => b.setAttribute('aria-pressed', 'true'));
      pressedTag = state.tag;
    }

    // ── Render ─────────────────────────────────────────────────────────────
    function apply() {
      const filtered = isFiltered();
      const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
      if (words.length) ensureHay();

      // One pass: whether each entry matches, plus facet counts. A facet
      // value counts entries that pass every *other* filter.
      const counts = { status: new Map<string, number>(), type: new Map<string, number>(), topic: new Map<string, number>() };
      const inc = (m: Map<string, number>, k: string) => m.set(k, (m.get(k) ?? 0) + 1);
      for (const it of items) {
        const fStatus = !!state.status && it.status !== state.status;
        const fType = !!state.type && it.type !== state.type;
        const fTopic = !!state.topic && !it.topics.has(state.topic);
        const fRest = (!!state.tag && !it.tags.has(state.tag)) || (words.length > 0 && !words.every((w) => it.hay.includes(w)));
        it.ok = !(fStatus || fType || fTopic || fRest);
        if (fRest || +fStatus + +fType + +fTopic > 1) continue;
        if (!fType && !fTopic) { inc(counts.status, ''); inc(counts.status, it.status); }
        if (!fStatus && !fTopic) { inc(counts.type, ''); inc(counts.type, it.type); }
        if (!fStatus && !fType) { inc(counts.topic, ''); it.topics.forEach((t) => inc(counts.topic, t)); }
      }

      const visible: string[] = [];
      for (const s of sections) {
        // Reorder the DOM only when the sort actually changed.
        if (s.sortedBy !== state.sort) {
          const sorter = sorters[state.sort];
          s.order = sorter ? [...s.entries].sort(sorter) : s.original;
          s.list.replaceChildren(...s.order.map((x) => x.li), ...(sorter ? s.heads.map((h) => h.li) : []));
          if (sorter) s.heads.forEach((h) => (h.li.hidden = true));
          s.sortedBy = state.sort;
        }

        const sectionHidden = !!state.status && state.status !== s.id;
        let matched = 0;
        let head: Head | null = null;
        let headMatched = 0;
        let headShown = 0;
        const closeHead = () => {
          if (!head) return;
          head.li.hidden = headShown === 0;
          head.count.textContent = String(headMatched);
        };
        s.shown = [];

        for (const x of s.order) {
          if (x.kind === 'head') {
            closeHead();
            head = x;
            headMatched = headShown = 0;
            continue;
          }
          const ok = !sectionHidden && x.ok;
          const show = ok && s.shown.length < s.limit;
          if (ok) {
            matched++;
            headMatched++;
            visible.push(x.slug);
          }
          if (show) {
            s.shown.push(x);
            headShown++;
          }
          if (x.li.hidden === show) x.li.hidden = !show;
        }
        closeHead();

        const remaining = matched - s.shown.length;
        s.el.hidden = sectionHidden || matched === 0;
        s.row.hidden = remaining <= 0;
        if (remaining > 0) {
          const step = Math.min(PAGE, remaining);
          s.more.textContent = remaining > step ? `Show ${step} more (${remaining} remaining)` : `Show ${step} more`;
          s.all.hidden = remaining <= step;
          s.all.textContent = `Show all ${matched}`;
        }
        s.countEl.textContent = filtered ? `${matched} of ${s.entries.length}` : String(matched);
      }

      for (const f of facetBtns) {
        const n = counts[f.key].get(f.value) ?? 0;
        if (f.n) f.n.textContent = String(n);
        const pressed = state[f.key] === f.value;
        f.btn.setAttribute('aria-pressed', String(pressed));
        f.btn.classList.toggle('empty-facet', n === 0 && !pressed);
      }

      syncTagButtons();
      tagChip.hidden = !state.tag;
      tagChip.textContent = `#${state.tag} ✕`;
      tagChip.title = 'Remove tag filter';

      const total = `${items.length} ${items.length === 1 ? 'entry' : 'entries'}`;
      countEl.textContent = filtered ? `${visible.length} of ${total}` : total;
      clearBtn.hidden = !filtered;
      emptyEl.hidden = !filtered || visible.length > 0;

      writeUrl();
      lastVisible = filtered ? visible : null;
      announce();
    }

    let lastVisible: string[] | null = null;
    const announce = () => document.dispatchEvent(new CustomEvent('readinglist:change', {
      detail: { topic: state.topic || null, visible: lastVisible },
    }));
    // The map may initialise after us; resend the state once it's listening.
    document.addEventListener('topicmap:ready', announce);

    /** Change filters / sort; every section goes back to its first page. */
    function set(patch: Partial<State>) {
      Object.assign(state, patch);
      const first = isFiltered() ? FIRST_FILTERED : FIRST;
      sections.forEach((s) => (s.limit = first));
      apply();
    }

    function clearAll() {
      input.value = '';
      set({ q: '', status: '', type: '', topic: '', tag: '' });
    }

    // ── Wiring ─────────────────────────────────────────────────────────────
    let typing: number | undefined;
    input.addEventListener('input', () => {
      clearTimeout(typing);
      typing = window.setTimeout(() => set({ q: input.value.trim() }), 120);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        clearTimeout(typing);
        input.value = '';
        set({ q: '' });
        input.blur();
      }
    });

    // "/" jumps to search, unless already typing somewhere.
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
      if (t.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName)) return;
      e.preventDefault();
      input.focus();
    });

    sortSel.addEventListener('change', () => set({ sort: sortSel.value }));

    facetBtns.forEach(({ btn, key, value }) => btn.addEventListener('click', () => {
      // Topic chips toggle; status/type segments always select.
      set({ [key]: key === 'topic' && state.topic === value ? '' : value });
    }));

    root.addEventListener('click', (e) => {
      const target = e.target as Element;
      const tag = target.closest<HTMLButtonElement>('.paper-item .tag');
      if (tag) {
        rove(tag);
        const t = tag.textContent!.trim();
        set({ tag: state.tag === t ? '' : t });
      }
      if (target.closest('[data-clear]')) clearAll();
    });
    tagChip.addEventListener('click', () => set({ tag: '' }));
    clearBtn.addEventListener('click', clearAll);

    // Inline tags: one tab stop per entry, arrow keys move within it.
    function rove(to: HTMLButtonElement) {
      to.parentElement!.querySelectorAll<HTMLButtonElement>('.tag').forEach((b) => (b.tabIndex = b === to ? 0 : -1));
    }
    root.addEventListener('keydown', (e) => {
      const tag = (e.target as Element).closest<HTMLButtonElement>('.paper-item .tag');
      if (!tag) return;
      const all = [...tag.parentElement!.querySelectorAll<HTMLButtonElement>('.tag')];
      const i = all.indexOf(tag);
      const keys: Record<string, number> = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: all.length - 1 };
      const j = keys[e.key];
      if (j === undefined) return;
      e.preventDefault();
      const next = all[(j + all.length) % all.length];
      rove(next);
      next.focus();
    });

    // Paging: reveal the next step and move focus to the first new entry, so
    // keyboard users continue where the list grew (viewport stays put).
    sections.forEach((s) => {
      const grow = (to: number) => {
        const before = s.shown.length;
        s.limit = to;
        apply();
        s.shown[before]?.link.focus({ preventScroll: true });
      };
      s.more.addEventListener('click', () => grow(s.shown.length + PAGE));
      s.all.addEventListener('click', () => grow(Infinity));
    });

    // Hovering (or focusing) an entry highlights its dot in the topic map.
    let hovered: string | null = null;
    const hover = (el: EventTarget | null) => {
      const li = el instanceof Element ? el.closest('.paper-item') : null;
      const slug = (li && itemByLi.get(li)?.slug) ?? null;
      if (slug === hovered) return;
      hovered = slug;
      document.dispatchEvent(new CustomEvent('readinglist:hover', { detail: { slug } }));
    };
    root.addEventListener('mouseover', (e) => hover(e.target));
    root.addEventListener('mouseleave', () => hover(null));
    root.addEventListener('focusin', (e) => hover(e.target));
    root.addEventListener('focusout', (e) => hover(e.relatedTarget));

    // Clicking a topic in the map toggles the topic filter.
    document.addEventListener('topicmap:select', (e) => {
      const { topic } = (e as CustomEvent).detail;
      set({ topic: state.topic === topic ? '' : topic });
      // If the list's top has scrolled out of view, bring the filters back.
      if (toolbar.getBoundingClientRect().top < 0) {
        toolbar.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    set({});
  }
</script>
