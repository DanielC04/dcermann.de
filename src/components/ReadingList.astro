    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--contrast-color);
    background: none;
    border: 1px dashed color-mix(in srgb, var(--contrast-color) 50%, transparent);
    border-radius: 6px;
    padding: 0.4rem 0.9rem;
    cursor: pointer;

    &:hover { background: color-mix(in srgb, var(--contrast-color) 8%, transparent); }
  }

  .show-all {
    font: inherit;
    font-size: 0.78rem;
    color: var(--text-color-dim);
    background: none;
    border: 0;
    padding: 0.4rem 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;

    &:hover { color: var(--contrast-color); }
    &[hidden] { display: none; }
  }

  .empty {
    color: var(--text-color-dim);
    font-size: 0.9rem;

    &[hidden] { display: none; }
