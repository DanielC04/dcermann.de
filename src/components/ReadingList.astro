  }

  .paper-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--text-color-dim) 20%, transparent);
  }

  .group-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 1.1rem 0 0.35rem;
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-color);

