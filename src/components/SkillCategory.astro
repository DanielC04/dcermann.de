---
import type { SkillCategory } from '../data/skills';

interface Props {
  category: SkillCategory;
}

const { category } = Astro.props;

// Flag emojis are used for language skills; devicon/FA classes for everything else.
function isEmoji(icon: string): boolean {
  return /^\p{Emoji}/u.test(icon);
}
---

<div class="skill-category reveal">
  <h3 class="category-name">{category.name}</h3>
  <ul class="skill-list" role="list">
    {category.skills.map((skill) => (
      <li class="skill">
        <div class="skill-label">
          <span
            class:list={[
              'skill-icon',
              { 'skill-icon--class': !isEmoji(skill.icon) },
            ]}
            aria-hidden="true"
          >
            {isEmoji(skill.icon) ? (
              skill.icon
            ) : (
              <i class={skill.icon}></i>
            )}
          </span>
          <span class="skill-name">{skill.name}</span>
          {skill.description && (
            <span class="skill-desc" title={skill.description}>
              — {skill.description}
            </span>
          )}
        </div>
        <div
          class="proficiency-track"
          role="progressbar"
          aria-valuenow={skill.proficiency}
          aria-valuemin={0}
          aria-valuemax={100}
          aria-label={`${skill.name} proficiency`}
        >
          <div
            class="proficiency-bar"
            data-pct={skill.proficiency}
            style="width: 0%"
          >
            <span class="bar-name">{skill.name}</span>
            <span class="bar-pct">{skill.proficiency}%</span>
          </div>
        </div>
      </li>
    ))}
  </ul>
</div>

<style lang="scss">
  .skill-category {
    background-color: var(--background-color);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    border: 1px solid color-mix(in srgb, var(--text-color) 10%, transparent);
  }

  .category-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--contrast-color);
    margin: 0 0 1rem;
  }

  .skill-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .skill {
    font-size: 0.95rem;
  }

  .skill-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 5px;
    flex-wrap: wrap;
  }

  .skill-icon {
    font-size: 1.25em;
    width: 1.5em;
    text-align: center;
    flex-shrink: 0;
  }

  .skill-name {
    font-weight: 600;
  }

  .skill-desc {
    font-size: 0.85em;
    color: var(--text-color-dim);
  }

  .proficiency-track {
    width: 100%;
    height: 1.75em;
    background-color: var(--background-color-2);
    border-radius: 0.5em;
    position: relative;
    overflow: visible;
  }

  .proficiency-bar {
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 0.5em;
    background: linear-gradient(
      90deg,
      var(--contrast-color),
      color-mix(in srgb, var(--text-color) 65%, var(--contrast-color))
    );
    display: flex;
    align-items: center;
    overflow: hidden;
    transition: width 1s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: 2em;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .bar-name {
    padding: 0 6px;
    font-size: 0.8em;
    font-weight: 600;
    color: var(--background-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bar-pct {
    position: absolute;
    right: 0;
    transform: translateX(calc(100% + 8px));
    font-size: 0.8em;
    color: var(--text-color-dim);
    white-space: nowrap;
  }
</style>

<script>
  // Animate proficiency bars when they scroll into view
  const bars = document.querySelectorAll<HTMLElement>('.proficiency-bar');
  if (bars.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const bar = entry.target as HTMLElement;
            const pct = bar.dataset.pct ?? '0';
            bar.style.width = `${pct}%`;
            observer.unobserve(bar);
          }
        });
      },
      { threshold: 0.2 },
    );
    bars.forEach((bar) => observer.observe(bar));
  }
</script>
