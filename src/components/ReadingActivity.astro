---
import { getCollection } from 'astro:content';

const allPapers = await getCollection('papers', ({ data }) => !data.draft);
const readPapers = allPapers.filter((p) => p.data.status === 'read' && p.data.dateRead);

// Serialise date → count map for client-side use. dateRead is UTC midnight,
// so use UTC parts to match the YYYY-MM-DD written in the file.
const dateEntries: Record<string, number> = {};
for (const paper of readPapers) {
  const dr = paper.data.dateRead!;
  const key = `${dr.getUTCFullYear()}-${String(dr.getUTCMonth() + 1).padStart(2, '0')}-${String(dr.getUTCDate()).padStart(2, '0')}`;
  dateEntries[key] = (dateEntries[key] ?? 0) + 1;
}

const totalRead = readPapers.length;

const CELL    = 9;   // px
const GAP     = 2;   // px
const LABEL_W = 22;  // px
---

<div class="activity-widget">
  <div class="widget-header">
    <span class="widget-title">Reading Activity</span>
    <span class="widget-stats">
      <span class="stat">{totalRead} read</span>
      <span class="sep">·</span>
      <span class="stat" id="ra-streak"></span>
      <span class="sep">·</span>
      <span class="stat" id="ra-best"></span>
    </span>
  </div>

  <div class="grid-scroll">
    <div class="grid-inner" id="ra-grid"></div>
  </div>

  <div class="legend">
    <span class="legend-label">Less</span>
    <div class="cell legend-cell"></div>
    <div class="cell legend-cell active"></div>
    <div class="cell legend-cell active multi"></div>
    <span class="legend-label">More</span>
  </div>
</div>

<script define:vars={{ dateEntries, CELL, GAP, LABEL_W }}>
(function () {
  const WEEKS = 26;
  const step  = CELL + GAP;

  const today = new Date();
  today.setHours(0, 0, 0, 0);

  function localKey(d) {
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }

  function fmt(d) {
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  // Build 26-week grid aligned to Monday
  const gridStart = new Date(today);
  gridStart.setDate(gridStart.getDate() - WEEKS * 7 + 1);
  const startDow = (gridStart.getDay() + 6) % 7; // 0=Mon … 6=Sun
  gridStart.setDate(gridStart.getDate() - startDow);

  const days = [];
  const cursor = new Date(gridStart);
  while (cursor <= today || days.length % 7 !== 0) {
    const key = localKey(cursor);
    days.push({ date: new Date(cursor), count: dateEntries[key] ?? 0, future: cursor > today });
    cursor.setDate(cursor.getDate() + 1);
  }

  // Group into week columns (oldest first)
  const weeks = [];
  for (let i = 0; i < days.length; i += 7) weeks.push(days.slice(i, i + 7));

  const weekHasRead = weeks.map(w => w.some(d => d.count > 0));

  const todayWeekIdx = weeks.findLastIndex(w =>
    w.some(d => d.date <= today && d.date >= new Date(today.getTime() - 6 * 86400000))
  );

  let currentStreak = 0;
  for (let i = todayWeekIdx; i >= 0; i--) {
    if (weekHasRead[i]) currentStreak++;
    else break;
  }

  let longestStreak = 0, run = 0;
  for (const has of weekHasRead) {
    if (has) { run++; longestStreak = Math.max(longestStreak, run); }
    else run = 0;
  }

  document.getElementById('ra-streak').textContent = `${currentStreak}w streak`;
  document.getElementById('ra-best').textContent    = `best ${longestStreak}w`;

  // Reverse so today is on the left
  weeks.reverse();

  // Month labels — skip if within 3 columns of the previous label to prevent overlap
  const monthLabels = [];
  let lastMonth = -1;
  let lastLabelCol = -99;
  weeks.forEach((week, col) => {
    const m = week[0].date.getMonth();
    if (m !== lastMonth && col - lastLabelCol >= 3) {
      monthLabels.push({ label: week[0].date.toLocaleDateString('en-GB', { month: 'short' }), col });
      lastMonth = m;
      lastLabelCol = col;
    }
  });

  // Build DOM
  const gridInner = document.getElementById('ra-grid');
  gridInner.style.width = `${LABEL_W + weeks.length * step}px`;
  gridInner.style.display = 'inline-block';
  gridInner.style.paddingBottom = '2px';

  const monthRow = document.createElement('div');
  monthRow.className = 'month-row';
  monthRow.style.paddingLeft = `${LABEL_W}px`;
  monthLabels.forEach(({ label, col }) => {
    const span = document.createElement('span');
    span.className = 'month-label';
    span.style.left = `${LABEL_W + col * step}px`;
    span.textContent = label;
    monthRow.appendChild(span);
  });
  gridInner.appendChild(monthRow);

  const gridBody = document.createElement('div');
  gridBody.className = 'grid-body';

  const dayLabels = document.createElement('div');
  dayLabels.className = 'day-labels';
  ['Mon', '', 'Wed', '', 'Fri', '', ''].forEach(d => {
    const span = document.createElement('span');
    span.textContent = d;
    dayLabels.appendChild(span);
  });
  gridBody.appendChild(dayLabels);

  const weekColumns = document.createElement('div');
  weekColumns.className = 'week-columns';
  weeks.forEach(week => {
    const col = document.createElement('div');
    col.className = 'week-col';
    week.forEach(cell => {
      const div = document.createElement('div');
      const cls = ['cell'];
      if (cell.count > 0) cls.push('active');
      if (cell.count > 1) cls.push('multi');
      if (cell.future)    cls.push('future');
      div.className = cls.join(' ');
      div.title = cell.count > 0
        ? `${cell.count} paper${cell.count > 1 ? 's' : ''} · ${fmt(cell.date)}`
        : fmt(cell.date);
      div.setAttribute('aria-label', cell.count > 0
        ? `${cell.count} paper${cell.count > 1 ? 's' : ''} read on ${fmt(cell.date)}`
        : `No papers on ${fmt(cell.date)}`);
      col.appendChild(div);
    });
    weekColumns.appendChild(col);
  });
  gridBody.appendChild(weekColumns);
  gridInner.appendChild(gridBody);
})();
</script>

<style lang="scss" is:global define:vars={{ cellPx: `${CELL}px`, gapPx: `${GAP}px`, labelW: `${LABEL_W}px` }}>
  .activity-widget {
    margin-bottom: 3rem;
    padding: 1.1rem 1.25rem 1rem;
    border: 1px solid color-mix(in srgb, var(--text-color-dim) 20%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--background-color-1) 70%, transparent);
    position: relative;
    overflow: hidden;

    // scanline texture
    &::before {
      content: '';
      pointer-events: none;
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        to bottom,
        transparent 0px,
        transparent 3px,
        color-mix(in srgb, var(--text-color) 2%, transparent) 3px,
        color-mix(in srgb, var(--text-color) 2%, transparent) 4px
      );
      z-index: 0;
    }
  }

  .widget-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .widget-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--contrast-color);
  }

  .widget-stats {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.72rem;
    color: var(--text-color-dim);
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .stat { color: var(--text-color); }
  .sep  { opacity: 0.4; }

  // ── Grid ─────────────────────────────────────────────────────────────────

  .grid-scroll {
    position: relative;
    z-index: 1;
    overflow-x: auto;
    overflow-y: visible;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--text-color-dim) 25%, transparent) transparent;
  }

  .grid-inner {
    display: inline-block;
    padding-bottom: 2px;
  }

  .month-row {
    position: relative;
    height: 16px;
    margin-bottom: 4px;
  }

  .month-label {
    position: absolute;
    font-size: 0.68rem;
    font-family: 'Space Mono', 'Courier New', monospace;
    color: var(--text-color-dim);
    white-space: nowrap;
    top: 0;
  }

  .grid-body {
    display: flex;
    gap: var(--gapPx);
    align-items: flex-start;
  }

  .day-labels {
    display: flex;
    flex-direction: column;
    gap: var(--gapPx);
    flex-shrink: 0;
    width: var(--labelW);

    span {
      height: var(--cellPx);
      font-size: 0.62rem;
      font-family: 'Space Mono', 'Courier New', monospace;
      color: var(--text-color-dim);
      line-height: var(--cellPx);
      opacity: 0.6;
    }
  }

  .week-columns {
    display: flex;
    gap: var(--gapPx);
  }

  .week-col {
    display: flex;
    flex-direction: column;
    gap: var(--gapPx);
  }

  // ── Cells ─────────────────────────────────────────────────────────────────

  .cell {
    width:  var(--cellPx);
    height: var(--cellPx);
    border-radius: 3px;
    background: color-mix(in srgb, var(--text-color-dim) 10%, transparent);
    cursor: default;

    &.future {
      opacity: 0.25;
    }

    &.active {
      background: color-mix(in srgb, var(--contrast-color) 55%, transparent);
    }

    &.multi {
      background: var(--contrast-color);
    }
  }

  // ── Legend ────────────────────────────────────────────────────────────────

  .legend {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 0.7rem;
    justify-content: flex-end;
  }

  .legend-label {
    font-size: 0.65rem;
    font-family: 'Space Mono', 'Courier New', monospace;
    color: var(--text-color-dim);
    opacity: 0.6;
    margin: 0 2px;
  }

  .legend-cell {
    cursor: default;
  }
</style>
