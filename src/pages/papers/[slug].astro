---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { url } from '../../utils/url';

export async function getStaticPaths() {
  const papers = await getCollection('papers');
  // Only generate detail pages for papers that have a body
  return papers
    .filter((p) => (p.body ?? '').trim().length > 0)
    .map((paper) => ({
      params: { slug: paper.slug },
      props: { paper },
    }));
}

const { paper } = Astro.props;
const { Content } = await paper.render();

const dateStr = paper.data.dateRead?.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const authorStr =
  paper.data.authors.slice(0, 3).join(', ') +
  (paper.data.authors.length > 3 ? ' et al.' : '');
---

<BaseLayout
  title={paper.data.title}
  description={paper.data.tldr ?? `Reading notes on "${paper.data.title}"`}
>
  <section id="paper-detail">
    <div class="section-container">
      <nav class="breadcrumb">
        <a href={url('/papers')}>← Reading list</a>
      </nav>

      <header class="paper-header">
        <div class="paper-meta">
          <span class="authors">{authorStr}</span>
          <span class="sep">·</span>
          <span class="year">{paper.data.year}</span>
          {dateStr && (
            <>
              <span class="sep">·</span>
              <span>read <time datetime={paper.data.dateRead!.toISOString()}>{dateStr}</time></span>
            </>
          )}
        </div>

        <h1>{paper.data.title}</h1>

        {paper.data.tldr && (
          <p class="tldr">{paper.data.tldr}</p>
        )}

        <div class="paper-actions">
          <a
            class="source-link"
            href={paper.data.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            Read the paper ↗
          </a>
          {paper.data.tags.length > 0 && (
            <ul class="tag-list" role="list">
              {paper.data.tags.map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
          )}
        </div>
      </header>

      <article class="prose">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  #paper-detail {
    background-color: var(--background-color);
    min-height: calc(100vh - 60px);
    padding-bottom: 5rem;
  }

  .breadcrumb {
    margin-bottom: 2.5rem;
    font-size: 0.9rem;

    a {
      color: var(--contrast-color);
    }
  }

  .paper-header {
    max-width: 72ch;
    margin: 0 auto 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--text-color-dim) 20%, transparent);

    h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(1.5rem, 4vw, 2.25rem);
      font-weight: 700;
      color: var(--text-color);
      margin: 0.5rem 0 1rem;
      line-height: 1.25;
    }
  }

  .paper-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-color-dim);
    margin-bottom: 0.25rem;
  }

  .sep {
    color: color-mix(in srgb, var(--text-color-dim) 50%, transparent);
  }

  .tldr {
    font-size: 1.05rem;
    color: var(--text-color-dim);
    line-height: 1.65;
    margin: 0 0 1.25rem;
    font-style: italic;
  }

  .paper-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .source-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--contrast-color);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    font-size: 0.72rem;
    color: var(--text-color-dim);
    border: 1px solid color-mix(in srgb, var(--text-color-dim) 35%, transparent);
    border-radius: 999px;
    padding: 0.1em 0.6em;
  }
</style>
