---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingList from '../../components/ReadingList.astro';
import ReadingActivity from '../../components/ReadingActivity.astro';
import TopicMap from '../../components/TopicMap.astro';
---

<BaseLayout
  title="Reading List"
  description="Papers I'm reading or have read, with notes on the ones that stuck."
>
  <section id="papers">
    <div class="section-container">

      <div class="page-layout">

        <!-- Left: intro + reading list -->
        <div class="left-col">
          <div class="page-intro">
            <h2>Reading List</h2>
            <p class="page-desc">
              Papers and books I'm reading or have read. Entries marked <span class="note-mark">✦</span> have reading notes.
            </p>
          </div>
          <ReadingList />
        </div>

        <!-- Right: reading activity heatmap + topic map -->
        <aside class="right-col">
          <ReadingActivity />
          <TopicMap />
        </aside>

      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  #papers {
    background-color: var(--background-color);
    min-height: calc(100vh - 60px);
    padding-bottom: 5rem;
    // Global `section { overflow: hidden }` would turn this into a scroll
    // container and break the sticky topic map; `clip` clips without that.
    overflow: clip;
  }

  // ── Two-column layout ─────────────────────────────────────────────────
  .page-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2.5rem;
    align-items: start;

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  // ── Columns — min-width: 0 prevents grid items from forcing column wider than 1fr
  .left-col,
  .right-col {
    min-width: 0;
  }

  .page-intro {
    margin-bottom: 1.5rem;

    :global(h2) {
      text-align: left;
    }

    :global(h2::after) {
      left: 0;
      transform: none;
    }
  }

  .page-desc {
    font-size: 0.9rem;
    color: var(--text-color-dim);
    margin-top: 0.5rem;
    margin-bottom: 0;
    line-height: 1.6;
    max-width: 50ch;
  }

  .note-mark {
    color: var(--contrast-color);
    font-size: 0.8em;
  }

  // ── Right column — activity scrolls away, the topic map (TopicMap) sticks.
  // Stretch to the full row height so the sticky map has room to travel.
  .right-col {
    align-self: stretch;

    @media (max-width: 768px) {
      // On mobile the aside comes after the list; bump it up so it appears
      // first in reading order (grid-row reorder)
      order: -1;
    }
  }
</style>
