---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingList from '../../components/ReadingList.astro';
import ReadingActivity from '../../components/ReadingActivity.astro';
import TopicMap from '../../components/TopicMap.astro';
---

<BaseLayout
  title="Reading List"
  description="Papers I'm reading or have read, with notes on the ones that stuck."
>
  <section id="papers">
    <div class="section-container">

      <!--
        One grid, four areas. DOM order is the mobile reading and tab order:
        intro → activity → list → topic map. On desktop the activity and the
        (sticky) topic map sit in a right column beside the list.
      -->
      <div class="page-layout">
        <div class="area-intro page-intro">
          <h2>Reading List</h2>
          <p class="page-desc">
            Papers and books I'm reading or have read. Entries marked <span class="note-mark">✦</span> have reading notes.
          </p>
        </div>

        <aside class="area-activity" aria-label="Reading activity">
          <ReadingActivity />
        </aside>

        <div class="area-list">
          <ReadingList />
        </div>

        <aside class="area-map" aria-label="Topic map">
          <TopicMap />
        </aside>
      </div>

    </div>
  </section>
</BaseLayout>

<style lang="scss">
  #papers {
    background-color: var(--background-color);
    min-height: calc(100vh - 60px);
    padding-bottom: 5rem;
    // Global `section { overflow: hidden }` would turn this into a scroll
    // container and break the sticky topic map; `clip` clips without that.
    overflow: clip;
  }

  // ── Layout ────────────────────────────────────────────────────────────
  // Mobile: a single column in DOM order (no visual reordering, so focus
  // order matches what you see). Desktop: the list on the left; on the right
  // the activity widget next to the intro, then the topic map, whose area
  // stretches to the bottom of the list so the card inside can stay sticky.
  .page-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 2rem;

    @media (min-width: 769px) {
      grid-template-columns: minmax(0, 1fr) 340px;
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'intro activity'
        'list  activity'
        'list  map';
      column-gap: 2.5rem;
      row-gap: 0;
    }
  }

  .area-intro,
  .area-activity,
  .area-list,
  .area-map {
    min-width: 0;   // don't let content force a column wider than its track
  }

  @media (min-width: 769px) {
    .area-intro    { grid-area: intro; }
    .area-activity { grid-area: activity; align-self: start; }
    .area-list     { grid-area: list; }
    .area-map      { grid-area: map; align-self: stretch; }
  }

  // On mobile the grid gap does the spacing.
  @media (max-width: 768px) {
    .area-intro { margin-bottom: 0; }
    .area-activity :global(.activity-widget) { margin-bottom: 0; }
  }

  .page-intro {
    margin-bottom: 1.5rem;

    :global(h2) {
      text-align: left;
    }

    :global(h2::after) {
      left: 0;
      transform: none;
    }
  }

  .page-desc {
    font-size: 0.9rem;
    color: var(--text-color-dim);
    margin-top: 0.5rem;
    margin-bottom: 0;
    line-height: 1.6;
    max-width: 50ch;
  }

  .note-mark {
    color: var(--contrast-color);
    font-size: 0.8em;
  }
</style>
