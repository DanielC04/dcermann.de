---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingList from '../../components/ReadingList.astro';
import ReadingActivity from '../../components/ReadingActivity.astro';
---

<BaseLayout
  title="Reading List"
  description="Papers I'm reading or have read, with notes on the ones that stuck."
>
  <section id="papers">
    <div class="section-container">
      <div class="page-header">
        <div class="page-intro">
          <h2>Reading List</h2>
          <p class="page-desc">
            Papers I'm reading or have read. Entries marked <span class="note-mark">✦</span> have reading notes.
          </p>
        </div>
        <ReadingActivity />
      </div>
      <ReadingList />
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  #papers {
    background-color: var(--background-color);
    min-height: calc(100vh - 60px);
    padding-bottom: 5rem;
  }

  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .page-intro {
    flex: 1;
    min-width: 0;

    // h2 is globally centered with position:relative tricks; override for inline context
    :global(h2) {
      position: static;
      transform: none;
      text-align: left;
      display: block;
      left: unset;
    }
  }

  .page-desc {
    font-size: 0.9rem;
    color: var(--text-color-dim);
    margin-top: 0.5rem;
    margin-bottom: 0;
    line-height: 1.6;
    max-width: 50ch;
  }

  .note-mark {
    color: var(--contrast-color);
    font-size: 0.8em;
  }
</style>
