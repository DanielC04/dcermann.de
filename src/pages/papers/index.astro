---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingList from '../../components/ReadingList.astro';
import ReadingActivity from '../../components/ReadingActivity.astro';
import PaperMap from '../../components/PaperMap.astro';
---

<BaseLayout
  title="Reading List"
  description="Papers I'm reading or have read, with notes on the ones that stuck."
>
  <section id="papers">
    <div class="section-container">

      <div class="page-layout">

        <!-- Left: intro + activity heatmap + reading list -->
        <div class="left-col">
          <div class="page-intro">
            <h2>Reading List</h2>
            <p class="page-desc">
              Papers I'm reading or have read. Entries marked <span class="note-mark">✦</span> have reading notes.
            </p>
          </div>
          <ReadingActivity />
          <ReadingList />
        </div>

        <!-- Right: Paper Topics 3-D map (sticky) -->
        <aside class="right-col">
          <PaperMap />
        </aside>

      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  #papers {
    background-color: var(--background-color);
    min-height: calc(100vh - 60px);
    padding-bottom: 5rem;
  }

  // ── Two-column layout ─────────────────────────────────────────────────
  .page-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2.5rem;
    align-items: start;

    @media (max-width: 860px) {
      grid-template-columns: 1fr;
    }
  }

  // ── Left column ───────────────────────────────────────────────────────
  .left-col {
    min-width: 0;  // prevent grid blowout
  }

  .page-intro {
    margin-bottom: 1.5rem;

    // h2 is globally centred with position tricks; override for inline context
    :global(h2) {
      position: static;
      transform: none;
      text-align: left;
      display: block;
      left: unset;
    }
  }

  .page-desc {
    font-size: 0.9rem;
    color: var(--text-color-dim);
    margin-top: 0.5rem;
    margin-bottom: 0;
    line-height: 1.6;
    max-width: 50ch;
  }

  .note-mark {
    color: var(--contrast-color);
    font-size: 0.8em;
  }

  // ── Right column — sticky Paper Topics ───────────────────────────────
  .right-col {
    position: sticky;
    top: 80px;

    @media (max-width: 860px) {
      position: static;
      // On mobile the aside comes after the list; bump it up so it appears
      // first in reading order (grid-row reorder)
      order: -1;
    }
  }
</style>
