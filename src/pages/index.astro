---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CVEntry from '../components/CVEntry.astro';
import { getCollection } from 'astro:content';
import { siteInfo } from '../data/site';
import { experiences } from '../data/experience';
import { skillCategories } from '../data/skills';
import { projects } from '../data/projects';
import { url } from '../utils/url';
import profilePhoto from '../assets/images/myProfile.png';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);

// Only show spoken languages in sidebar
const cvSkills = skillCategories.filter((c) =>
  c.name.toLowerCase().includes('languages i speak'),
);
---

<BaseLayout
  title="Daniel Cermann"
  description="Software Engineer & maker from Germany — blog, projects, and more."
>
  <div class="cv-page">

    <!-- ── Header ──────────────────────────────────────────────────────── -->
    <header class="cv-header">
      <div class="cv-identity">
        <h1 class="cv-name">{siteInfo.name}</h1>
        <p class="cv-role">Software Engineer · IT-Systems Engineering @ HPI</p>
      </div>
      <div class="cv-social">
        {siteInfo.social.map((s) => (
          <a
            href={s.url}
            class="cv-social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.name}
          >
            <i class={s.icon} aria-hidden="true"></i>
            <span>{s.name}</span>
          </a>
        ))}
        <a
          href={url('/cv_daniel_cermann.pdf')}
          class="cv-social-link cv-download"
          download
        >
          <i class="fa-solid fa-download" aria-hidden="true"></i>
          <span>Download CV</span>
        </a>
      </div>
    </header>

    <!-- ── Body ────────────────────────────────────────────────────────── -->
    <div class="cv-body">

      <!-- Sidebar -->
      <aside class="cv-sidebar">
        <div class="sidebar-photo">
          <Image
            src={profilePhoto}
            alt="Daniel Cermann"
            width={90}
            height={90}
            loading="eager"
          />
        </div>

        <nav aria-label="Quick navigation">
          <h3 class="sidebar-heading">Navigate</h3>
          <ul class="sidebar-nav">
            <li><a href={url('/blog')}>Blog</a></li>
            <li><a href={url('/projects')}>Projects</a></li>
            <li><a href={url('/papers')}>Reading list</a></li>
          </ul>
        </nav>

        {cvSkills.map((cat) => (
          <div class="skill-group">
            <h3 class="sidebar-heading">{cat.name}</h3>
            <ul class="skill-list">
              {cat.skills.map((skill) => (
                <li class="skill-item">
                  {(skill.icon.startsWith('devicon') || skill.icon.startsWith('fas')) ? (
                    <i class={skill.icon} aria-hidden="true"></i>
                  ) : (
                    <span aria-hidden="true">{skill.icon}</span>
                  )}
                  <span class="skill-name">{skill.name}</span>
                  {skill.description && (
                    <span class="skill-detail"> — {skill.description}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="skill-group">
          <h3 class="sidebar-heading">Interests</h3>
          <ul class="interest-list">
            <li>AI safety</li>
            <li>Biomedical informatics</li>
            <li>Green energy market</li>
          </ul>
        </div>
      </aside>

      <!-- Main -->
      <main class="cv-main">
        <!-- Summary -->
        <p class="cv-summary">{siteInfo.description}</p>

        <!-- Experience -->
        <section class="cv-section">
          <h2 class="cv-section-heading">Experience</h2>
          {experiences.map((item) => <CVEntry item={item} />)}
        </section>

        <!-- Projects -->
        <section class="cv-section">
          <h2 class="cv-section-heading">Projects</h2>
          <div class="project-list">
            {projects.map((p) => (
              <div class="project-entry">
                <div class="project-entry-head">
                  <a
                    class="project-title"
                    href={p.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {p.title}
                  </a>
                  <div class="project-meta">
                    <span class="project-icons">
                      {p.technologies.map((t) => (
                        <i class={t.icon} title={t.name} aria-label={t.name}></i>
                      ))}
                    </span>
                    <span class="project-year">{p.startDate}</span>
                  </div>
                </div>
                <p class="project-desc">{p.description}</p>
              </div>
            ))}
          </div>
          <a class="see-all" href={url('/projects')}>See all projects →</a>
        </section>

        <!-- Recent writing -->
        {latestPosts.length > 0 && (
          <section class="cv-section">
            <h2 class="cv-section-heading">Recent Writing</h2>
            <div class="post-list">
              {latestPosts.map((post) => (
                <a class="post-entry" href={url(`/blog/${post.slug}`)}>
                  <span class="post-title">{post.data.title}</span>
                  <time
                    class="post-date"
                    datetime={post.data.pubDate.toISOString()}
                  >
                    {post.data.pubDate.toLocaleDateString('en-GB', {
                      month: 'short',
                      year: 'numeric',
                    })}
                  </time>
                  <span class="post-desc">{post.data.description}</span>
                </a>
              ))}
            </div>
            <a class="see-all" href={url('/blog')}>All posts →</a>
          </section>
        )}
      </main>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
  // ── Page wrapper (div, not section — avoids global section styles) ────
  .cv-page {
    background-color: var(--background-color);
    min-height: calc(100vh - 60px);
  }

  // ── Header ───────────────────────────────────────────────────────────
  .cv-header {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 1.5rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--text-color) 12%, transparent);
  }

  .cv-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.9rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -1px;
    margin: 0;
    color: var(--text-color);
  }

  .cv-role {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.9rem;
    color: var(--text-color-dim);
    margin: 0.2rem 0 0;
  }

  .cv-social {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .cv-social-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-color-dim);
    text-decoration: none;
    font-size: 0.85rem;
    font-family: 'Space Grotesk', sans-serif;
    transition: color 0.2s;

    i { font-size: 1rem; }

    &:hover {
      color: var(--contrast-color);
      text-decoration: none;
    }
  }

  .cv-download {
    color: var(--contrast-color);
    border: 1px solid color-mix(in srgb, var(--contrast-color) 40%, transparent);
    border-radius: 6px;
    padding: 0.3rem 0.7rem;

    &:hover {
      background-color: color-mix(in srgb, var(--contrast-color) 10%, transparent);
    }
  }

  // ── Body layout ──────────────────────────────────────────────────────
  .cv-body {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    align-items: start;

    > * { min-width: 0; }

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  // ── Sidebar ───────────────────────────────────────────────────────────
  .cv-sidebar {
    position: sticky;
    top: 76px;
    border-right: 1px solid color-mix(in srgb, var(--text-color) 8%, transparent);
    padding-right: 2rem;

    @media (max-width: 768px) {
      position: static;
      border-right: none;
      border-bottom: 1px solid color-mix(in srgb, var(--text-color) 8%, transparent);
      padding-right: 0;
      padding-bottom: 2rem;
      margin-bottom: 2rem;
      order: 2;
    }
  }

  .cv-main {
    @media (max-width: 768px) {
      order: 1;
    }
  }

  .sidebar-photo {
    margin-bottom: 1.5rem;

    img {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      object-fit: cover;
    }
  }

  .sidebar-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--contrast-color);
    margin: 1.5rem 0 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid color-mix(in srgb, var(--text-color-dim) 12%, transparent);

    &:first-of-type { margin-top: 0; }
  }

  .sidebar-nav {
    list-style: none;
    margin: 0 0 0.25rem;
    padding: 0;

    li { margin-bottom: 0.35rem; }

    a {
      font-size: 0.83rem;
      color: var(--text-color-dim);
      text-decoration: none;
      font-family: 'Space Grotesk', sans-serif;
      transition: color 0.2s;

      &:hover { color: var(--contrast-color); }
    }
  }

  .skill-group { margin-bottom: 0.1rem; }

  .skill-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .skill-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.81rem;
    padding: 0.18rem 0;
    color: var(--text-color-dim);

    i, span:first-child {
      font-size: 0.9rem;
      width: 1em;
      text-align: center;
      flex-shrink: 0;
      color: var(--text-color-dim);
    }
  }

  .skill-name { color: var(--text-color); font-weight: 500; }
  .skill-detail { font-size: 0.76rem; }

  .interest-list {
    list-style: none;
    margin: 0;
    padding: 0;

    li {
      font-size: 0.81rem;
      color: var(--text-color-dim);
      padding: 0.18rem 0;

      &::before {
        content: '— ';
        color: var(--contrast-color);
      }
    }
  }

  // ── Main & section headings ──────────────────────────────────────────
  .cv-main {
    padding-top: 0.25rem;
  }

  .cv-summary {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--text-color-dim);
    max-width: 68ch;
    border-left: 3px solid var(--contrast-color);
    padding-left: 1rem;
    margin: 0 0 2.5rem;
  }

  .cv-section {
    margin-bottom: 2.5rem;
  }

  .cv-section-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--contrast-color);
    margin: 0 0 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--text-color-dim) 15%, transparent);
    display: block;
    position: static;
    text-align: left;
    letter-spacing: 3px;
  }

  // ── Projects ─────────────────────────────────────────────────────────
  .project-list { display: flex; flex-direction: column; }

  .project-entry {
    padding: 0.9rem 0;
    border-top: 1px solid color-mix(in srgb, var(--text-color-dim) 12%, transparent);

    &:last-child {
      border-bottom: 1px solid color-mix(in srgb, var(--text-color-dim) 12%, transparent);
    }
  }

  .project-entry-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }

  .project-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-color);
    text-decoration: none;
    transition: color 0.2s;

    &:hover { color: var(--contrast-color); }
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .project-icons {
    display: flex;
    gap: 0.35rem;

    i { font-size: 1rem; color: var(--text-color-dim); }
  }

  .project-year {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.72rem;
    color: var(--contrast-color);
  }

  .project-desc {
    font-size: 0.87rem;
    color: var(--text-color-dim);
    line-height: 1.6;
    margin: 0;
  }

  // ── Recent writing ────────────────────────────────────────────────────
  .post-list { display: flex; flex-direction: column; }

  .post-entry {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    row-gap: 0.15rem;
    padding: 0.9rem 0;
    border-top: 1px solid color-mix(in srgb, var(--text-color-dim) 12%, transparent);
    text-decoration: none;

    &:last-child {
      border-bottom: 1px solid color-mix(in srgb, var(--text-color-dim) 12%, transparent);
    }

    &:hover .post-title { color: var(--contrast-color); }
  }

  .post-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-color);
    grid-column: 1;
    grid-row: 1;
    transition: color 0.2s;
  }

  .post-date {
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 0.72rem;
    color: var(--contrast-color);
    grid-column: 2;
    grid-row: 1;
    white-space: nowrap;
    align-self: center;
  }

  .post-desc {
    font-size: 0.87rem;
    color: var(--text-color-dim);
    line-height: 1.55;
    grid-column: 1 / -1;
    grid-row: 2;
  }

  // ── Shared ───────────────────────────────────────────────────────────
  .see-all {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--contrast-color);
    text-decoration: none;
    font-family: 'Space Grotesk', sans-serif;

    &:hover { text-decoration: underline; }
  }
</style>
